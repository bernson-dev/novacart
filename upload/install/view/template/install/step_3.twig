{{ header }}
<div class="container">
    <header>
        <div class="row">
            <div class="col-md-8 col-sm-6">
                <h1 class="pull-left">3<small>/5</small></h1>
                <h3>{{ heading_title }}<br/><small>{{ text_step_3 }}</small></h3>
            </div>
            <div class="col-md-4 col-sm-6">
                <div id="logo" class="pull-right hidden-xs"><img src="view/image/logo.png" alt="NovaCart" title="NovaCart"/></div>
            </div>
        </div>
    </header>
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible">
        <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="row">
        <div class="col-sm-9">
            <form action="{{ action }}" method="post" class="form-horizontal">
                <p>{{ text_db_connection }}</p>
                <fieldset>
                    <div class="form-group{% if error_db_driver %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-db-driver">{{ entry_db_driver }}</label>
                        <div class="col-sm-9">
                            <select name="db_driver" id="input-db-driver" class="form-control">
                                {% for driver in drivers %}
                                <option value="{{ driver.value }}"{% if db_driver == driver.value %} selected="selected"{% endif %}>{{ driver.text }}</option>
                                {% endfor %}
                            </select>
                            {% if error_db_driver %}<div class="text-danger">{{ error_db_driver }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="form-group required{% if error_db_hostname %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-db-hostname">{{ entry_db_hostname }}</label>
                        <div class="col-sm-9">
                            <input type="text" name="db_hostname" value="{{ db_hostname }}" id="input-db-hostname" class="form-control"/>
                            {% if error_db_hostname %}<div class="text-danger">{{ error_db_hostname }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="form-group required{% if error_db_username %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-db-username">{{ entry_db_username }}</label>
                        <div class="col-sm-9">
                            <input type="text" name="db_username" value="{{ db_username }}" id="input-db-username" class="form-control"/>
                            {% if error_db_username %}<div class="text-danger">{{ error_db_username }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label" for="input-db-password">{{ entry_db_password }}</label>
                        <div class="col-sm-9"><input type="password" name="db_password" value="{{ db_password }}" id="input-db-password" class="form-control"/></div>
                    </div>
                    <div class="form-group required{% if error_db_database %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-db-database">{{ entry_db_database }}</label>
                        <div class="col-sm-9">
                            <input type="text" name="db_database" value="{{ db_database }}" id="input-db-database" class="form-control"/>
                            {% if error_db_database %}<div class="text-danger">{{ error_db_database }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="form-group required{% if error_db_port %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-db-port">{{ entry_db_port }}</label>
                        <div class="col-sm-9">
                            <input type="text" name="db_port" value="{{ db_port }}" id="input-db-port" class="form-control"/>
                            {% if error_db_port %}<div class="text-danger">{{ error_db_port }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="form-group{% if error_db_prefix %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-db-prefix">{{ entry_db_prefix }}</label>
                        <div class="col-sm-9">
                            <input type="text" name="db_prefix" value="{{ db_prefix }}" id="input-db-prefix" class="form-control"/>
                            {% if error_db_prefix %}<div class="text-danger">{{ error_db_prefix }}</div>{% endif %}
                        </div>
                    </div>
                </fieldset>

                <p>{{ text_db_administration }}</p>
                <fieldset>
                    <div class="form-group required{% if error_username %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-username">{{ entry_username }}</label>
                        <div class="col-sm-9">
                            <input type="text" name="username" value="{{ username }}" id="input-username" class="form-control"/>
                            {% if error_username %}<div class="text-danger">{{ error_username }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="form-group required{% if error_password %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-password">{{ entry_password }}</label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input type="text" name="password" value="{{ password }}" id="input-password" class="form-control" autocomplete="new-password"/>
                                <span class="input-group-btn"><button type="button" id="generate-password" class="btn btn-primary" title="Generate password"><i class="fa fa-refresh"></i></button></span>
                            </div>
                            {% if error_password %}<div class="text-danger">{{ error_password }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="form-group required{% if error_email %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-email">{{ entry_email }}</label>
                        <div class="col-sm-9">
                            <input type="email" name="email" value="{{ email }}" id="input-email" class="form-control"/>
                            {% if error_email %}<div class="text-danger">{{ error_email }}</div>{% endif %}
                        </div>
                    </div>
                </fieldset>

                <p>{{ text_dump_select }}</p>
                <fieldset>
                    <div class="form-group{% if error_sql_dump %} has-error{% endif %}">
                        <label class="col-sm-3 control-label" for="input-sql-dump">{{ text_dump }}</label>
                        <div class="col-sm-9">
                            <select name="sql_dump" id="input-sql-dump" class="form-control">
                                {% for dump in sql_dumps %}
                                <option value="{{ dump }}"{% if sql_dump == dump %} selected="selected"{% endif %}>{{ dump }}</option>
                                {% endfor %}
                            </select>
                            {% if error_sql_dump %}<div class="text-danger">{{ error_sql_dump }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label" for="input-repair-schema">{{ entry_repair_schema }}</label>
                        <div class="col-sm-9">
                            <div class="checkbox">
                                <label><input type="checkbox" name="repair_schema" value="1" id="input-repair-schema"{% if repair_schema %} checked="checked"{% endif %}/> {{ text_repair_schema }}</label>
                            </div>
                            <p class="help-block">{{ help_repair_schema }}</p>
                        </div>
                    </div>
                </fieldset>

                <div class="buttons">
                    <div class="pull-left"><a href="{{ back }}" class="btn btn-default">{{ button_back }}</a></div>
                    <div class="pull-right"><input type="submit" value="{{ button_continue }}" class="btn btn-primary"{% if not drivers or not sql_dumps %} disabled="disabled"{% endif %}/></div>
                </div>
            </form>
        </div>
        <div class="col-sm-3">{{ column_left }}</div>
    </div>
</div>
<script>
(function() {
    var button = document.getElementById('generate-password');
    var input = document.getElementById('input-password');

    if (!button || !input) {
        return;
    }

    button.addEventListener('click', function() {
        var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*';
        var bytes = new Uint32Array(16);

        if (window.crypto && window.crypto.getRandomValues) {
            window.crypto.getRandomValues(bytes);
        } else {
            for (var i = 0; i < bytes.length; i++) {
                bytes[i] = Math.floor(Math.random() * 4294967296);
            }
        }

        var password = '';
        for (var j = 0; j < bytes.length; j++) {
            password += chars.charAt(bytes[j] % chars.length);
        }

        input.value = password;
    });
})();
</script>
{{ footer }}