{{ header }}
<div class="container">
    <header>
        <div class="row">
            <div class="col-md-8 col-sm-6">
                <h1 class="pull-left">5
                    <small>/5</small></h1>
                <h3>{{ heading_title }}<br>
                    <small>{{ text_step_4 }}</small></h3>
            </div>
            <div class="col-md-4 col-sm-6">
                <div id="logo" class="pull-right hidden-xs">
                    <img src="view/image/logo.png" alt="OpenCart" title="OpenCart">
                </div>
            </div>
        </div>
    </header>

    <div class="alert alert-danger alert-dismissible">
        <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <input class="form-check-input" style="margin-left: 20px;" type="checkbox" id="delete-install-folder" value="1">
        <label class="form-check-label" for="delete-install-folder" style="margin-left: 5px;">
            {{ text_install_deleted }}
        </label>
    </div>

    <!-- Блок для отображения сообщений -->
    <div id="message-box"></div>

<div class="visit">
    <div class="row">
        <div class="col-sm-5 col-sm-offset-1 text-center">
            <a href="../" id="go-to-catalog" class="button-block">
                <i class="fa fa-shopping-cart fa-5x"></i>
                <span>{{ text_catalog }}</span>
            </a>
        </div>
        <div class="col-sm-5 text-center">
            <a href="../admin/" id="go-to-admin" class="button-block">
                <i class="fa fa-cog fa-5x white"></i>
                <span>{{ text_admin }}</span>
            </a>
        </div>
    </div>
</div>


</div>
{{ footer }}

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', () => {
        const deleteInstallFolderCheckbox = document.getElementById('delete-install-folder');
        const messageBox = document.getElementById('message-box');

        // Общая функция для обработки перехода
        function handleNavigation(event, targetUrl)
        {
            event.preventDefault();

            if (deleteInstallFolderCheckbox.checked) {
                deleteInstallFolder(() => {
                    setTimeout(() => {
                        window.location.href = targetUrl;
                    }, 2000); // Задержка 2 секунды после удаления папки
                });
            } else {
                setTimeout(() => {
                    window.location.href = targetUrl;
                }, 500); // Задержка 0.5 секунды без удаления папки
            }
        }

        // Обработчики для кнопок
        document.getElementById('go-to-catalog').addEventListener('click', (e) => {
            handleNavigation(e, '../');
        });

        document.getElementById('go-to-admin').addEventListener('click', (e) => {
            handleNavigation(e, '../admin/');
        });

        // Функция для удаления папки install
        function deleteInstallFolder(callback)
        {
            fetch('index.php?route=install/step_5/deleteInstallFolder', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    messageBox.innerHTML = `
                    <div class="alert alert-success">
                        <i class="fa fa-check-circle"></i> ${data.success}
                    </div>`;
                    //console.log('Папка install успешно удалена');
                } else if (data.error) {
                    messageBox.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-circle"></i> ${data.error}
                    </div>`;
                    //console.error('Ошибка при удалении папки install: ' + data.error);
                }
                callback();
            })
            .catch(error => {
                //console.error('Ошибка при удалении папки install:', error);
                callback();
            });
        }
    });
</script>
