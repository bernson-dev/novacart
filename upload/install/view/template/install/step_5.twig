{{ header }}
<div class="container cc-installer-finish">
  <header class="cc-finish-header">
    <span class="cc-finish-step">5 <small>/ 5</small></span>
    <img src="view/image/logo.png" alt="NovaCart" class="cc-finish-logo">
  </header>
  <main class="cc-finish-panel">
    <div class="cc-finish-heading">
      <span class="cc-complete-icon"><i class="fa fa-check"></i></span>
      <h1>{{ heading_title }}</h1>
      <p>{{ text_step_4 }}</p>
    </div>
    <div class="cc-summary" aria-label="{{ heading_title }}">
      {% for item in install_summary %}
        <div class="cc-summary-row"><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>
      {% endfor %}
    </div>
    <div class="cc-finish-warning">
      <div class="cc-finish-warning-title"><i class="fa fa-exclamation-triangle"></i> {{ error_warning }}</div>
      <label class="cc-cleanup-label"><input type="checkbox" id="delete-install-folder" value="1"><span>{{ text_install_deleted }}</span></label>
    </div>
    <div id="message-box" aria-live="polite"></div>
    <div class="cc-finish-actions">
      <a href="../" id="go-to-catalog" class="cc-finish-button"><i class="fa fa-shopping-cart"></i><span>{{ text_catalog }}</span></a>
      <a href="../admin/" id="go-to-admin" class="cc-finish-button"><i class="fa fa-cog"></i><span>{{ text_admin }}</span></a>
    </div>
  </main>
</div>
{{ footer }}

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', () => {
        const deleteInstallFolderCheckbox = document.getElementById('delete-install-folder');
        const messageBox = document.getElementById('message-box');

        // Общая функция для обработки перехода
        function handleNavigation(event, targetUrl)
        {
            event.preventDefault();

            if (deleteInstallFolderCheckbox.checked) {
                deleteInstallFolder(() => {
                    setTimeout(() => {
                        window.location.href = targetUrl;
                    }, 2000); // Задержка 2 секунды после удаления папки
                });
            } else {
                setTimeout(() => {
                    window.location.href = targetUrl;
                }, 500); // Задержка 0.5 секунды без удаления папки
            }
        }

        // Обработчики для кнопок
        document.getElementById('go-to-catalog').addEventListener('click', (e) => {
            handleNavigation(e, '../');
        });

        document.getElementById('go-to-admin').addEventListener('click', (e) => {
            handleNavigation(e, '../admin/');
        });

        // Функция для удаления папки install
        function deleteInstallFolder(callback)
        {
            fetch('index.php?route=install/step_5/deleteInstallFolder', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    messageBox.innerHTML = `
                    <div class="alert alert-success">
                        <i class="fa fa-check-circle"></i> ${data.success}
                    </div>`;
                    //console.log('Папка install успешно удалена');
                } else if (data.error) {
                    messageBox.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-circle"></i> ${data.error}
                    </div>`;
                    //console.error('Ошибка при удалении папки install: ' + data.error);
                }
                callback();
            })
            .catch(error => {
                //console.error('Ошибка при удалении папки install:', error);
                callback();
            });
        }
    });
</script>
