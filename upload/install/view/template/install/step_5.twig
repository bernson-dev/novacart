{{ header }}
<div class="container cc-installer-finish">
  <header class="cc-finish-header">
    <span class="cc-finish-step">5 <small>/ 5</small></span>
    <img src="view/image/logo.png" alt="NovaCart" class="cc-finish-logo">
  </header>
  <main class="cc-finish-panel">
    <div class="cc-finish-heading">
      <span class="cc-complete-icon"><i class="fa fa-check"></i></span>
      <h1>{{ heading_title }}</h1>
      <p>{{ text_step_4 }}</p>
    </div>
    <div class="cc-summary" aria-label="{{ heading_title }}">
      {% for item in install_summary %}
        <div class="cc-summary-row"><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>
      {% endfor %}
    </div>
    <div class="cc-finish-warning">
      <div class="cc-finish-warning-title"><i class="fa fa-exclamation-triangle"></i> {{ error_warning }}</div>
      <label class="cc-cleanup-label"><input type="checkbox" id="delete-install-folder" value="1"><span>{{ text_install_deleted }}</span></label>
    </div>
    <div id="message-box" aria-live="polite"></div>
    <div class="cc-finish-actions">
      <a href="../" id="go-to-catalog" class="cc-finish-button"><i class="fa fa-shopping-cart"></i><span>{{ text_catalog }}</span></a>
      <a href="../admin/" id="go-to-admin" class="cc-finish-button"><i class="fa fa-cog"></i><span>{{ text_admin }}</span></a>
    </div>
  </main>
</div>
{{ footer }}

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function () {
    var cleanup = document.getElementById('delete-install-folder');
    var message = document.getElementById('message-box');
    var links = [document.getElementById('go-to-catalog'), document.getElementById('go-to-admin')];
    links.forEach(function (link) {
        link.addEventListener('click', function (event) {
            if (!cleanup || !cleanup.checked) { return; }
            event.preventDefault();
            if (link.dataset.busy === '1') { return; }
            link.dataset.busy = '1';
            fetch('index.php?route=install/step_5/deleteInstallFolder', {
                method: 'POST',
                credentials: 'same-origin'
            }).then(function (response) {
                if (!response.ok) { throw new Error('HTTP ' + response.status); }
                return response.json();
            }).then(function (result) {
                if (result.success || result.pending) {
                    window.location.href = link.href;
                    return;
                }
                throw new Error(result.error || 'Installer cleanup failed');
            }).catch(function (error) {
                message.textContent = error.message;
                message.className = 'alert alert-danger';
                link.dataset.busy = '0';
            });
        });
    });
});
</script>
