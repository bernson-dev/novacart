{{ header }}
<div class="container">
  {{ step_header }}
  {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
  {% endif %}

  <div class="row">
    <div class="col-sm-9 cc-check-main">
      <form action="{{ action }}" method="post">
          {% set groups = [
            {'title': text_install_php, 'rows': php_checks, 'paths': false},
            {'title': text_install_extension, 'rows': extension_checks, 'paths': false},
            {'title': text_install_file, 'rows': file_checks, 'paths': true},
            {'title': text_install_directory, 'rows': directory_checks, 'paths': true}
          ] %}

          {% for group in groups %}
            <section class="cc-check-card">
              <p class="cc-check-card__title">{{ group.title }}</p>
              <div class="table-responsive">
              <table class="table table-striped table-bordered table-condensed cc-check-table {% if group.paths %}cc-check-table--paths{% else %}cc-check-table--requirements{% endif %}">
                <thead>
                  <tr>
                    <th>{% if group.paths %}{{ text_file }} / {{ text_directory }}{% else %}{{ text_setting }}{% endif %}</th>
                    <th>{% if group.paths %}{{ text_status }}{% else %}{{ text_current }}{% endif %}</th>
                    {% if group.paths %}
                      <th class="text-center">CHMOD</th>
                    {% else %}
                      <th>{{ text_required }}</th>
                    {% endif %}
                    <th class="text-center" title="{{ text_status }}"><i class="fa fa-check-circle-o" aria-hidden="true"></i></th>
                  </tr>
                </thead>
                <tbody>
                  {% for item in group.rows %}
                    <tr{% if not item.ok %} class="danger"{% endif %}>
                      <td class="cc-check-table__label">{{ item.label }}</td>
                      <td class="cc-check-table__value">
                        <span class="{% if item.ok %}text-success{% else %}text-danger{% endif %}">{{ item.current }}</span>
                      </td>
                      {% if group.paths %}
                        <td class="text-center">
                          <code class="{% if not item.permission_ok %}text-warning{% endif %}">{{ item.permissions }}</code>
                        </td>
                      {% else %}
                        <td>{{ item.required }}</td>
                      {% endif %}
                      <td class="text-center">
                        {% if item.ok %}
                          <i class="fa fa-check-circle text-success" aria-label="OK" title="OK"></i>
                        {% else %}
                          <i class="fa fa-times-circle text-danger" aria-label="Error" title="Error"></i>
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
              </div>
            </section>
          {% endfor %}

          <div class="buttons clearfix">
            <a href="{{ back }}" class="btn btn-default">{{ button_back }}</a>
            <button type="submit" class="btn btn-primary">{{ button_continue }}</button>
          </div>
      </form>
    </div>
    <div class="col-sm-3">{{ column_left }}</div>
  </div>
</div>
{{ footer }}
