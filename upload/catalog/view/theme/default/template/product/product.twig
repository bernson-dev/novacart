    <script type="text/javascript">
    (function() {
        var originalButton = document.getElementById('button-cart');
        var stickyBar = document.getElementById('product-sticky-buy');
        var stickyButton = document.getElementById('button-cart-sticky');
        var originalQuantity = document.getElementById('input-quantity');
        var stickyQuantity = document.getElementById('sticky-input-quantity');
        var productContent = document.querySelector('#product-product #content');

        if (!originalButton || !stickyBar || !stickyButton || !originalQuantity || !stickyQuantity) {
            return;
        }

        var ticking = false;

        function updateStickyGeometry() {
            if (window.matchMedia('(max-width: 767px)').matches || !productContent) {
                stickyBar.style.left = '0';
                stickyBar.style.width = '100%';
                return;
            }

            var contentRect = productContent.getBoundingClientRect();

            stickyBar.style.left = Math.max(0, contentRect.left) + 'px';
            stickyBar.style.width = Math.max(0, contentRect.width) + 'px';
        }

        function syncStickyButton() {
            stickyButton.className = originalButton.className
                .replace(/\bbtn-lg\b/g, '')
                .replace(/\bbtn-block\b/g, '')
                .replace(/\s+/g, ' ')
                .trim();

            stickyButton.innerHTML = originalButton.innerHTML;
            stickyButton.disabled = originalButton.disabled;
            stickyButton.setAttribute('aria-disabled', originalButton.disabled ? 'true' : 'false');

            if (originalButton.style.display === 'none') {
                hideStickyBar();
            }
        }

        function syncQuantityFromOriginal() {
            if (stickyQuantity.value !== originalQuantity.value) {
                stickyQuantity.value = originalQuantity.value;
            }
        }

        function showStickyBar() {
            if (originalButton.style.display === 'none') {
                return;
            }

            stickyBar.classList.add('is-visible');
            stickyBar.setAttribute('aria-hidden', 'false');
            document.body.classList.add('product-sticky-buy-active');
        }

        function hideStickyBar() {
            stickyBar.classList.remove('is-visible');
            stickyBar.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('product-sticky-buy-active');
        }

        function updateStickyVisibility() {
            ticking = false;

            if (originalButton.style.display === 'none') {
                hideStickyBar();
                return;
            }

            var rect = originalButton.getBoundingClientRect();

            // Show only after the real purchase button has scrolled above the viewport.
            // Do not show the duplicate action while the original button is still ahead.
            if (rect.bottom <= 8) {
                showStickyBar();
            } else {
                hideStickyBar();
            }
        }

        function requestVisibilityUpdate() {
            if (!ticking) {
                ticking = true;
                window.requestAnimationFrame(function() {
                    updateStickyGeometry();
                    updateStickyVisibility();
                });
            }
        }

        stickyQuantity.addEventListener('input', function() {
            originalQuantity.value = this.value;
            $(originalQuantity).trigger('input');
        });

        stickyQuantity.addEventListener('change', function() {
            originalQuantity.value = this.value;
            $(originalQuantity).trigger('change');
        });

        originalQuantity.addEventListener('input', syncQuantityFromOriginal);
        originalQuantity.addEventListener('change', syncQuantityFromOriginal);

        stickyButton.addEventListener('click', function() {
            if (!originalButton.disabled && originalButton.style.display !== 'none') {
                originalButton.click();
            }
        });

        if (window.MutationObserver) {
            new MutationObserver(function() {
                syncStickyButton();
                requestVisibilityUpdate();
            }).observe(originalButton, {
                attributes: true,
                childList: true,
                subtree: true,
                attributeFilter: ['class', 'disabled', 'style', 'aria-disabled']
            });
        }

        window.addEventListener('scroll', requestVisibilityUpdate, { passive: true });
        window.addEventListener('resize', requestVisibilityUpdate);

        if (window.ResizeObserver && productContent) {
            new ResizeObserver(function() {
                updateStickyGeometry();
            }).observe(productContent);
        }

        syncStickyButton();
        syncQuantityFromOriginal();
        updateStickyGeometry();
        updateStickyVisibility();
    })();
    </script>
