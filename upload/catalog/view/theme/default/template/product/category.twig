{{ header }}
<div id="product-category" class="container">
    <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>
    <div class="row">{{ column_left }}
        {% if column_left and column_right %}
        {% set class = 'col-sm-6' %}
        {% elseif column_left or column_right %}
        {% set class = 'col-sm-9' %}
        {% else %}
        {% set class = 'col-sm-12' %}
        {% endif %}
        <div id="content" class="{{ class }}">{{ content_top }}
            <h1>{{ heading_title }}</h1>
            {% if thumb or description %}
            <div class="row"> {% if thumb %}
                <div class="col-sm-2"><img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-thumbnail" /></div>
                {% endif %}
                {% if description %}
                <div class="col-sm-10">{{ description }}</div>
                {% endif %}</div>
            <hr>
            {% endif %}
            {% if categories %}
            <h3 class="category-refine-title">{{ text_refine }}</h3>
            <div class="category-refine-grid">
                {% for category in categories %}
                <a href="{{ category.href }}" class="category-refine-item">{{ category.name }}</a>
                {% endfor %}
            </div>
            {% endif %}
            {% if products %}
            <div class="row catalog-toolbar">
                <div class="col-md-2 col-sm-6 catalog-toolbar-view">
                    <div class="btn-group btn-group-sm">
                        <button type="button" id="list-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_list }}">
                            <i class="fa fa-th-list"></i></button>
                        <button type="button" id="grid-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_grid }}">
                            <i class="fa fa-th"></i></button>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 catalog-toolbar-compare">
                    <div class="form-group"><a href="{{ compare }}" id="compare-total" class="btn btn-link" aria-label="{{ text_compare }}" title="{{ text_compare }}"><i class="fa fa-exchange compare-icon" aria-hidden="true"></i><span class="compare-label">{{ text_compare }}</span></a></div>
                </div>
                <div class="col-md-4 col-xs-6 catalog-toolbar-sort">
                    <div class="form-group input-group input-group-sm catalog-control">
                        <label class="input-group-addon" for="input-sort">{{ text_sort }}</label>
                        <select id="input-sort" class="form-control" onchange="location = this.value;">
                            {% for sorts in sorts %}
                            {% if sorts.value == '%s-%s'|format(sort, order) %}
                            <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
                            {% else %}
                            <option value="{{ sorts.href }}">{{ sorts.text }}</option>

                            {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-xs-6 catalog-toolbar-limit">
                    <div class="form-group input-group input-group-sm catalog-control">
                        <label class="input-group-addon" for="input-limit">{{ text_limit }}</label>
                        <select id="input-limit" class="form-control" onchange="location = this.value;">
                            {% for limits in limits %}
                            {% if limits.value == limit %}
                            <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
                            {% else %}
                            <option value="{{ limits.href }}">{{ limits.text }}</option>
                            {% endif %}
                            {% endfor %}

                        </select>
                    </div>
                </div>
            </div>
            <div class="row catalog-results-row">
                {% for product in products %}
                <div class="product-layout product-list col-xs-12">
                    <div class="product-thumb">
                        <div class="image"><a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" /></a></div>
                        <div>
                            <div class="caption">
                                <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
                                <p>{{ product.description }}</p>
                                {% if product.price %}
                                <p class="price">
                                    {% if not product.special %}
                                    {{ product.price }}
                                    {% else %}
                                    <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
                                    {% endif %}
                                    {% if product.tax %} <span class="price-tax">{{ text_tax }} {{ product.tax }}</span> {% endif %} </p>
                                {% endif %}
                                {% if product.rating %}
                                <div class="rating"> {% for i in 1..5 %}
                                    {% if product.rating < i %}
                                    <span class="fa fa-stack">
                                        <i class="fa fa-star-o fa-stack-2x"></i></span> {% else %}
                                    <span class="fa fa-stack">
                                        <i class="fa fa-star fa-stack-2x"></i>
                                        <i class="fa fa-star-o fa-stack-2x"></i></span>
                                    {% endif %}
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                            <div class="button-group">
                                {% if product.can_buy %}
                            <button type="button" class="stock-cart-button{{ product.in_cart ? ' stock-cart-in-cart' : '' }}" data-product-id="{{ product.product_id }}" data-cart-label="{{ product.button_text ?: button_cart }}" aria-label="{{ product.in_cart ? product.cart_button_text : (product.button_text ?: button_cart) }}" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">
                                <i class="fa stock-cart-icon {{ product.in_cart ? 'fa-check' : 'fa-shopping-cart' }}" aria-hidden="true"></i><span class="stock-cart-label">{{ product.in_cart ? product.cart_button_text : (product.button_text ?: button_cart) }}</span></button>
                            {% elseif product.stock_button != 'hide' %}
                            <button type="button" disabled="disabled" aria-disabled="true" tabindex="-1" class="stock-purchase-disabled" title="{{ product.button_reason }}">
                                <i class="fa fa-ban" aria-hidden="true"></i> <span class="stock-cart-label">{{ product.button_text }}<small class="stock-disabled-reason">{{ product.button_reason }}</small></span></button>
                            {% endif %}
                                <button type="button" data-toggle="tooltip" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');">
                                    <i class="fa fa-heart"></i></button>
                                <button type="button" data-toggle="tooltip" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');">
                                    <i class="fa fa-exchange"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            <div class="row">
                <div class="col-sm-6 text-left">{{ pagination }}</div>
                <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
            {% endif %}
            {% if not categories and not products %}
            <p>{{ text_empty }}</p>
            <div class="buttons">
                <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
            </div>
            {% endif %}
            {{ content_bottom }}
        </div>
        {{ column_right }}
    </div>
</div>
{{ footer }}
