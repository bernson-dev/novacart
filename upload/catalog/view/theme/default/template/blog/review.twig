<style>
    #article-reviews .review-item {
        margin-bottom: 20px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 4px;
        background: #fff;
    }

    #article-reviews .review-item-header {
        margin-bottom: 10px;
    }

    #article-reviews .review-item-body p {
        margin: 0 0 10px;
        word-wrap: break-word;
        overflow-wrap: anywhere;
    }

    #article-reviews .review-item-rating {
        margin-top: 10px;
    }
</style>
{% if reviews %}
	{% for review in reviews %}
		<div class="review-item">
			<div class="review-item-header clearfix">
				<strong class="pull-left">{{ review.author }}</strong>
				<span class="pull-right text-muted">{{ review.date_added }}</span>
			</div>

			<div class="review-item-body">
				<p>{{ review.text }}</p>

				<div class="review-item-rating">
					{% for i in 1..5 %}
						{% if review.rating < i %}
							<span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>
						{% else %}
							<span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>
						{% endif %}
					{% endfor %}
				</div>
			</div>
		</div>
	{% endfor %}

	<div class="row">
		<div class="col-sm-6 text-left">{{ pagination }}</div>
		<div class="col-sm-6 text-right">{{ results }}</div>
	</div>
{% else %}
	<p>{{ text_no_reviews }}</p>
{% endif %}