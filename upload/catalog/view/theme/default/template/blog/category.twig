{# catalog/view/theme/default/template/blog/category.twig #}
{{ header }}
<div id="blog-category" class="container">
    <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>

    <div class="row">
        {{ column_left }}

        {% if column_left and column_right %}
        {% set class = 'col-sm-6' %}
        {% elseif column_left or column_right %}
        {% set class = 'col-sm-9' %}
        {% else %}
        {% set class = 'col-sm-12' %}
        {% endif %}

        <div id="content" class="{{ class }} showcase-list">
            {{ content_top }}

            <h1>{{ heading_title }}</h1>

            {% if thumb or description %}
            <div class="row">
                {% if thumb %}
                <div class="col-sm-2">
                    <img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-thumbnail" />
                </div>
                {% endif %}

                {% if description %}
                <div class="{% if thumb %}col-sm-10{% else %}col-sm-12{% endif %}">
                    {{ description }}
                </div>
                {% endif %}
            </div>
            <hr />
            {% endif %}

            {% if categories %}
            <h3>{{ text_refine }}</h3>
            <div class="list-group">
                {% for category in categories %}
                <a href="{{ category.href }}" class="list-group-item">{{ category.name }}</a>
                {% endfor %}
            </div>
            {% endif %}

            {% if articles %}
            <div class="row catalog-toolbar">
                <div class="col-md-3 col-sm-6 hidden-xs catalog-toolbar-view">
                    <div class="btn-group btn-group-sm">
                        <button type="button" id="list-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_list }}">
                            <i class="fa fa-th-list"></i>
                        </button>
                        <button type="button" id="grid-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_grid }}">
                            <i class="fa fa-th"></i>
                        </button>
                    </div>
                </div>

                <div class="col-md-5 col-xs-6 catalog-toolbar-sort">
                    <div class="form-group input-group input-group-sm catalog-control">
                        <label class="input-group-addon" for="input-sort">{{ text_sort }}</label>
                        <select id="input-sort" class="form-control" onchange="location = this.value;">
                            {% for sorts in sorts %}
                            {% if sorts.value == '%s-%s'|format(sort, order) %}
                            <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
                            {% else %}
                            <option value="{{ sorts.href }}">{{ sorts.text }}</option>
                            {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="col-md-4 col-xs-6 catalog-toolbar-limit">
                    <div class="form-group input-group input-group-sm catalog-control">
                        <label class="input-group-addon" for="input-limit">{{ text_limit }}</label>
                        <select id="input-limit" class="form-control" onchange="location = this.value;">
                            {% for limits in limits %}
                            {% if limits.value == limit %}
                            <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
                            {% else %}
                            <option value="{{ limits.href }}">{{ limits.text }}</option>
                            {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            <div class="row catalog-results-row blog-article-list">
                {% for article in articles %}
                <div class="product-layout product-list col-xs-12">
                    <div class="product-thumb blog-article-card">
                        <div class="image">
                            <a href="{{ article.href }}">
                                <img src="{{ article.thumb }}" alt="{{ article.name }}" title="{{ article.name }}" class="img-responsive" />
                            </a>
                        </div>

                        {# Keep the same DOM hierarchy as product/category.twig.
                           common.js can then switch product-list/product-grid without
                           blog-specific layout hacks. #}
                        <div class="blog-article-body">
                            <div class="caption">
                                <h4><a href="{{ article.href }}">{{ article.name }}</a></h4>
                                <p class="description">{{ article.description }}</p>

                                {% if configblog_review_status and article.rating is not same as(false) %}
                                <div class="rating">
                                    {% for i in 1..5 %}
                                    {% if article.rating < i %}
                                    <span class="fa fa-stack">
                                        <i class="fa fa-star-o fa-stack-2x"></i>
                                    </span>
                                    {% else %}
                                    <span class="fa fa-stack">
                                        <i class="fa fa-star fa-stack-2x"></i>
                                        <i class="fa fa-star-o fa-stack-2x"></i>
                                    </span>
                                    {% endif %}
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>

                            <div class="button-group blog-card-actions">
    <div class="blog-card-meta">
        <span class="blog-meta-item"><i class="fa fa-clock-o" aria-hidden="true"></i> {{ article.date_added }}</span>
        <span class="blog-meta-item"><i class="fa fa-eye blog-view-icon" aria-hidden="true"></i> {{ text_views }} {{ article.viewed }}</span>
    </div>
    <a class="blog-more" href="{{ article.href }}"><span>{{ button_more }}</span><i class="fa fa-arrow-right" aria-hidden="true"></i></a>
</div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <div class="row">
                <div class="col-sm-6 text-left">{{ pagination }}</div>
                <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
            {% else %}
            <p>{{ text_empty }}</p>
            <div class="buttons">
                <div class="pull-right">
                    <a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a>
                </div>
            </div>
            {% endif %}

            {{ content_bottom }}
        </div>

        {{ column_right }}
    </div>
</div>
{{ footer }}