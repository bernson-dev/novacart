{% if articles %}
	<h3>{{ heading_title }}</h3>
	<div class="row blog-article-list">
		{% for article in articles %}
			<div class="product-layout col-lg-3 col-md-3 col-sm-6 col-xs-12">
				<div class="product-thumb transition blog-article-card blog-card--module blog-card--featured">
					<div class="image"><a href="{{ article.href }}"><img src="{{ article.thumb }}" alt="{{ article.name }}" title="{{ article.name }}" class="img-responsive" /></a></div>
					<div class="blog-card-body">
					<div class="caption">
						<h4><a href="{{ article.href }}">{{ article.name }}</a></h4>
						<p>{{ article.description }}</p>
						{% if article.rating %}
							<div class="rating">
								{% for i in 1..5 %}
									{% if article.rating < i %}
										<span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>
									{% else %}
										<span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>
									{% endif %}
								{% endfor %}
							</div>
						{% endif %}
					</div>
					<div class="blog-card-meta">
						<span class="blog-meta-text blog-meta-text--date">{{ article.date_added }}</span>
						<span class="blog-meta-text blog-meta-text--views">{{ article.viewed }}</span>
					</div>
					<div class="blog-card-actions blog-card-actions--featured">
						<button type="button" class="blog-more" onclick="location.href = ('{{ article.href }}');">
							<span class="blog-more-label">{{ button_more }}</span>
						</button>
					</div>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>
{% endif %}