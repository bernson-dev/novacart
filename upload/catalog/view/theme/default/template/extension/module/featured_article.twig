{% if articles %}
	<h3>{{ heading_title }}</h3>
	<div class="row catalog-results-row blog-article-list blog-grid-mode">
		{% for article in articles %}
			<div class="product-layout blog-card-layout col-lg-4 col-md-4 col-sm-6 col-xs-12">
				<div class="product-thumb transition blog-article-card">
					<div class="image"><a href="{{ article.href }}"><img src="{{ article.thumb }}" alt="{{ article.name }}" title="{{ article.name }}" class="img-responsive" /></a></div>
					<div class="blog-article-body">
					<div class="caption">
						<h4><a href="{{ article.href }}">{{ article.name }}</a></h4>
						<p>{{ article.description }}</p>
						{% if article.rating %}
							<div class="rating">
								{% for i in 1..5 %}
									{% if article.rating < i %}
										<span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>
									{% else %}
										<span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>
									{% endif %}
								{% endfor %}
							</div>
						{% endif %}
					</div>
					<div class="button-group blog-card-actions">
    <div class="blog-card-meta">
        <span class="blog-meta-item"><i class="fa fa-clock-o" aria-hidden="true"></i> {{ article.date_added }}</span>
        <span class="blog-meta-item"><i class="fa fa-eye blog-view-icon" aria-hidden="true"></i> {{ text_views }} {{ article.viewed }}</span>
    </div>
    <a class="blog-more" href="{{ article.href }}"><span>{{ button_more }}</span><i class="fa fa-arrow-right" aria-hidden="true"></i></a>
</div>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>
{% endif %}