<div class="list-group">
	{% for category in categories %}
		{% if category.category_id == category_id %} 
			<a href="{{ category.href }}" class="list-group-item category-menu-parent active">{{ category.name }}</a> 
			{% if category.children %}
				{% for child in category.children %}
					{% if child.category_id == child_id %}
						<a href="{{ child.href }}" class="list-group-item category-menu-child active">{{ child.name }}</a> 
					{% else %} 
						<a href="{{ child.href }}" class="list-group-item category-menu-child">{{ child.name }}</a>
					{% endif %}
				{% endfor %}
			{% endif %}
		{% else %} <a href="{{ category.href }}" class="list-group-item category-menu-parent">{{ category.name }}</a>
		{% endif %}
	{% endfor %}
</div>
