            });
        });

        $('select[name=\'config_country_id\']').trigger('change');
    </script>

    <script>
        $(function () {
            const $inputSvg    = $('#input-svg-icon');
            const $color       = $('#input-favicon-color');
            const $colorGroup  = $('#favicon-color-group');
            const $preview     = $('#svg_icon_preview');
            const $original    = $('#input-favicon-original');
            const $clientError = $('#svg-icon-client-error');
            const previewUrl   = ($('#thumb-svg-icon').data('preview-url') || '').toString().replace(/&amp;/g, '&');

            function isSvg(path) {
                return /\.svg$/i.test(path || '');
            }

            function setPlaceholder() {
                const ph = $preview.attr('data-placeholder');
                if (ph)
                    $preview.attr('src', ph);
            }

            function refreshErrorHighlight($context) {
                $context.find('.text-danger').each(function () {
                    const $element = $(this).parent().parent();
                    if ($element.hasClass('form-group'))
                        $element.addClass('has-error');
                    $element.parents('.tab-pane').each(function () {
                        const id = $(this).attr('id');
                        if (id)
                            $('a[data-toggle="tab"][href="#' + id + '"]').addClass('has-error');
                    });
                });
            }

            function showSvgError(message) {
                $clientError.addClass('text-danger').text(message).show();
                refreshErrorHighlight($clientError.closest('.form-group'));
            }

            function hideSvgError() {
                const $group = $clientError.closest('.form-group');
                $clientError.removeClass('text-danger').hide().text('');
                $group.removeClass('has-error');
                $group.parents('.tab-pane').each(function () {
                    const id = $(this).attr('id');
                    if (id && $(this).find('.text-danger:visible').length === 0) {
                        $('a[data-toggle="tab"][href="#' + id + '"]').removeClass('has-error');
                    }
                });
            }

            function toggleColorState() {
                const isOriginal = $original.is(':checked');
                $color.prop('disabled', isOriginal);
                $colorGroup.toggle(!isOriginal);
            }

            function validateSvgSelection() {
                const path = $inputSvg.val();
                if (!path) {
                    hideSvgError(); return false;
                }

                if (!isSvg(path)) {
                    showSvgError('{{ error_svg_icon_client|e('js') }}');
                    // сбрасываем путь и показываем плейсхолдер
                    $inputSvg.val('');
                    setPlaceholder();
                    return false;
                }

                hideSvgError();
                return true;
            }

            function render() {
                toggleColorState();
                const path = $inputSvg.val();
                if (!path)
                    return setPlaceholder();
                if (!validateSvgSelection())
                    return;

                let src = previewUrl + '&path=' + encodeURIComponent(path) + '&_=' + Date.now();
                src += $original.is(':checked')
                ? '&original=1'
                : '&color=' + encodeURIComponent($color.val() || '#000000');

                $preview.attr('src', src);
            }

            // init
            render();

            // события
            $color.on('input change', render);
            $original.on('change', render);
            $inputSvg.on('change', render);
            $(document).on('hidden.bs.modal', '#modal-image', render);
            $(window).on('focus', render);
        });
    </script>
    <script type="text/javascript">
        // Geocode
        $('#button-geocode').on('click', function() {
            var address = $('textarea[name="config_address"]').val();

            if (address) {
                $('textarea[name="config_address"]').parent().parent().removeClass("has-error");
                $.ajax({
                    url: 'index.php?route=localisation/location/geocode&user_token={{ user_token }}&address=' + encodeURIComponent(address),
                    dataType: 'json',
                    crossDomain: true,
                    beforeSend: function() {
                        $('#button-geocode').button('loading');
                    },
                    complete: function() {
                        $('#button-geocode').button('reset');
                    },
                    success: function(json) {
                        $('#geocode-message').empty(); // очистить старое сообщение

                        if (json['lat'] && json['lng']) {
                            $('#input-geocode').val(json['lat'] + "," + json['lng']);
                            if (json['message']) {
                                var alertBox = $('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['message'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                                $('#geocode-message').html(alertBox);

                                // Автоматическое скрытие через 5 секунд
                                setTimeout(function() {
                                    alertBox.fadeOut('slow', function() { $(this).remove(); });
                                }, 5000);
                            }
                        } else if (json['error']) {
                            var alertBox = $('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                            $('#geocode-message').html(alertBox);

                            // Автоматическое скрытие через 7 секунд
                            setTimeout(function() {
                                alertBox.fadeOut('slow', function() { $(this).remove(); });
                            }, 7000);
                        }
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                        alert(json['error'] + thrownError);
                    }
                });
            } else {
                $('textarea[name="config_address"]').parent().parent().addClass("has-error");
                //alert('{{ text_geocode_empty }}');
                var alertBox = $('<div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + '{{ text_geocode_empty }}' + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                $('#geocode-message').html(alertBox);

                // Автоматическое скрытие через 7 секунд
                setTimeout(function() {
                    alertBox.fadeOut('slow', function() { $(this).remove(); });
                }, 7000);
            }
        });
    </script>
</div>
{{ footer }}
