{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid">
    <h1>{{ heading_title }}</h1>
    <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
  </div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-tasks"></i> {{ heading_title }}</h3></div>
      <div class="panel-body">
        <div class="row">
          <div class="col-sm-3"><div class="well">{{ text_pending }}: <strong>{{ stats.pending }}</strong></div></div>
          <div class="col-sm-3"><div class="well">{{ text_processing }}: <strong>{{ stats.processing }}</strong></div></div>
          <div class="col-sm-3"><div class="well">{{ text_done }}: <strong>{{ stats.done }}</strong></div></div>
          <div class="col-sm-3"><div class="well">{{ text_failed }}: <strong>{{ stats.failed }}</strong></div></div>
        </div>
        <p class="help-block">{{ text_queue_cli }}</p>
        <div class="row">
          <div class="col-sm-6">
            <label for="queue-status">{{ text_filter }}</label>
            <select id="queue-status" class="form-control" onchange="window.location.href=this.value">
              {% for value, name in {'all': text_all, 'pending': text_pending, 'processing': text_processing, 'done': text_done, 'failed': text_failed} %}
              <option value="{{ filter_url }}&amp;filter_status={{ value }}" {% if filter_status == value %}selected="selected"{% endif %}>{{ name }}</option>
              {% endfor %}
            </select>
          </div>
          {% if can_modify %}
          <div class="col-sm-6 text-right">
            <form method="post" action="{{ action }}" onsubmit="return confirm('{{ text_confirm_cleanup|e('js') }}')" style="margin-top:24px">
              <input type="hidden" name="queue_action" value="purge_done">
              <button type="submit" class="btn btn-default"><i class="fa fa-trash"></i> {{ button_cleanup }}</button>
            </form>
          </div>
          {% endif %}
        </div>
        <div class="table-responsive" style="margin-top:16px">
          <table class="table table-striped table-bordered table-hover">
            <thead><tr>
              <td>{{ column_id }}</td><td>{{ column_code }}</td><td>{{ column_route }}</td>
              <td>{{ column_status }}</td><td>{{ column_attempts }}</td>
              <td>{{ column_available }}</td><td>{{ column_locked }}</td><td>{{ column_error }}</td>
              <td class="text-right">{{ column_action }}</td>
            </tr></thead>
            <tbody>
            {% for job in jobs %}
              <tr>
                <td>{{ job.queue_id }}</td><td>{{ job.code }}</td><td><code>{{ job.route }}</code></td>
                <td>{{ attribute(_context, 'text_' ~ job.status)|default(job.status) }}</td>
                <td>{{ job.attempts }}/{{ job.max_attempts }}</td>
                <td>{{ job.available_at }}</td><td>{{ job.locked_at ?: '—' }}</td>
                <td style="max-width:320px;overflow-wrap:anywhere">{{ job.last_error ?: '—' }}</td>
                <td class="text-right">
                  {% if can_modify and job.status == 'failed' %}
                  <form method="post" action="{{ action }}" onsubmit="return confirm('{{ text_confirm_retry|e('js') }}')" style="display:inline">
                    <input type="hidden" name="queue_id" value="{{ job.queue_id }}">
                    <input type="hidden" name="queue_action" value="retry">
                    <button type="submit" class="btn btn-primary btn-sm">{{ button_retry }}</button>
                  </form>
                  {% elseif can_modify and job.status == 'done' %}
                  <form method="post" action="{{ action }}" onsubmit="return confirm('{{ text_confirm_delete|e('js') }}')" style="display:inline">
                    <input type="hidden" name="queue_id" value="{{ job.queue_id }}">
                    <input type="hidden" name="queue_action" value="delete_done">
                    <button type="submit" class="btn btn-danger btn-sm">{{ button_delete }}</button>
                  </form>
                  {% endif %}
                </td>
              </tr>
            {% else %}
              <tr><td colspan="9" class="text-center">{{ text_no_results }}</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
        <div class="row"><div class="col-sm-6">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
