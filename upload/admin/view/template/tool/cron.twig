{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button></div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-terminal"></i> {{ text_cron_commands }}</h3></div>
      <div class="panel-body">
        <p class="help-block">{{ text_cron_help }}</p>
        <div class="form-group">
          <label for="novacart-cron-cli">{{ text_cron_cli }}</label>
          <div class="input-group">
            <input id="novacart-cron-cli" type="text" readonly class="form-control" value="{{ cli_command }}">
            <span class="input-group-btn"><button class="btn btn-default js-cron-copy" type="button" data-copy="novacart-cron-cli" title="{{ text_cron_copy }}"><i class="fa fa-copy"></i></button></span>
          </div>
        </div>
        {% if http_command %}
        <div class="form-group">
          <label for="novacart-cron-web">{{ text_cron_web }}</label>
          <div class="input-group">
            <div id="novacart-cron-web" class="form-control" class="form-control nc-cron-web-command">{{ http_command }}</div>
            <span class="input-group-btn"><button class="btn btn-default js-cron-copy" type="button" data-copy="novacart-cron-web" title="{{ text_cron_copy }}"><i class="fa fa-copy"></i></button></span>
          </div>
          <p class="help-block">{{ text_cron_curl_help }}</p>
          {% if can_modify %}
          <form method="post" action="{{ action }}" onsubmit="return confirm('{{ text_cron_key_confirm|e('js') }}');">
            <input type="hidden" name="scheduler_action" value="rotate_http_key">
            <button type="submit" class="btn btn-default btn-sm"><i class="fa fa-refresh"></i> {{ text_cron_key_rotate }}</button>
          </form>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </div>

    <div class="panel panel-default" id="jobs-monitor">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-heartbeat"></i> {{ text_monitor }}</h3></div>
      <div class="panel-body">
        {% if heartbeat_status == 'none' %}
          <div class="alert alert-info">{{ text_heartbeat_missing }}</div>
        {% elseif heartbeat_status == 'error' %}
          <div class="alert alert-danger">{{ text_heartbeat_error }} ({{ heartbeat_minutes }} min)</div>
        {% elseif heartbeat_status == 'running' %}
          <div class="alert alert-info">{{ text_heartbeat_running }} ({{ heartbeat_minutes }} min)</div>
        {% elseif heartbeat_status == 'late' %}
          <div class="alert alert-warning">{{ text_heartbeat_late }} ({{ heartbeat_minutes }} min)</div>
        {% else %}
          <div class="alert alert-success">{{ text_heartbeat_ok }} ({{ heartbeat_minutes }} min)</div>
        {% endif %}
        <details id="jobs-monitor-history">
          <summary class="nc-monitor-history-toggle">
            <span><i class="fa fa-chevron-right nc-monitor-history-arrow" aria-hidden="true"></i> {{ text_monitor_history }}</span>
            <span class="nc-monitor-history-hint">{{ text_monitor_history_hint }}</span>
          </summary>
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead><tr>
              <td>{{ column_started }}</td><td>{{ column_source }}</td><td>{{ column_finished }}</td><td>{{ column_run_status }}</td>
              <td>{{ column_scheduler }}</td><td>{{ column_queue }}</td><td>{{ column_duration }}</td><td>{{ column_run_error }}</td>
            </tr></thead>
            <tbody>
            {% for run in job_runs %}
              <tr>
                <td>{{ run.started_at }}</td><td>{{ run_source_labels[run.source]|default(run.source) }}</td><td>{{ run.finished_at ?: '—' }}</td>
                <td>{{ run.status_display }}</td>
                <td>{{ run.scheduler_status_display }} ({{ run.scheduler_processed }}/{{ run.scheduler_failed }})</td>
                <td>{{ run.queue_status_display }} ({{ run.queue_processed }}/{{ run.queue_failed }})</td>
                <td>{{ run.duration_ms is not null ? run.duration_ms ~ ' ms' : '—' }}</td>
                <td>{{ run.error_message ? run.error_display : '—' }}</td>
              </tr>
            {% else %}
              <tr><td colspan="8" class="text-center">{{ text_monitor_empty }}</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
        </details>
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-clock-o"></i> {{ heading_title }}</h3></div>
      <div class="panel-body">
        <p class="help-block">{{ text_cli }}</p>
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead><tr>
              <td>{{ column_code }}</td><td>{{ column_route }}</td><td>{{ column_interval }}</td>
              <td>{{ column_status }}</td><td>{{ column_last }}</td><td>{{ column_next }}</td>
              <td>{{ column_result }}</td><td>{{ column_message }}</td><td class="text-right">{{ column_action }}</td>
            </tr></thead>
            <tbody>
              {% if tasks %}
                {% for task in tasks %}
                  <tr>
                    <td><strong>{{ task.code }}</strong>{% if task.code|slice(0, 5) == 'core.' %} <span class="label label-info">{{ text_system_task }}</span>{% endif %}</td><td><code>{{ task.route }}</code></td>
                    <td title="{{ task.interval_seconds }} {{ text_interval_seconds }}">{{ task.interval_display }}</td>
                    <td><span class="label label-{{ task.status ? 'success' : 'default' }}">{{ task.status ? text_enabled : text_disabled }}</span></td>
                    <td>{{ task.date_last ?: '—' }}</td><td>{{ task.date_next }}</td>
                    <td>{% if task.last_status %}<span class="label label-{{ task.last_status == 'success' ? 'success' : 'danger' }}">{{ task.status_display }}</span>{% if task.last_duration_ms is not null %} <small>{{ task.last_duration_ms }} ms</small>{% endif %}{% else %}—{% endif %}</td><td title="{{ task.message_display }}">{{ task.last_message ? task.message_display : '—' }}</td>
                    <td class="text-right" style="white-space:nowrap">
                      <a class="btn btn-sm btn-default" href="{{ action }}&history_id={{ task.cron_id }}#task-history" title="{{ text_task_history }}"><i class="fa fa-history"></i></a>
                      {% if can_modify %}
                        <form action="" method="post" style="display:inline">
                          <input type="hidden" name="scheduler_action" value="run">
                          <input type="hidden" name="cron_id" value="{{ task.cron_id }}">
                          <button class="btn btn-sm btn-info" title="{{ text_action_run }}"><i class="fa fa-play"></i></button>
                        </form>
                        <a class="btn btn-sm btn-primary" href="{{ action }}&edit_id={{ task.cron_id }}#scheduler-form" title="{{ text_action_edit }}"><i class="fa fa-pencil"></i></a>
                        {% if task.code|slice(0, 5) != 'core.' %}
                        <form action="" method="post" style="display:inline" onsubmit="return confirm('{{ text_action_confirm|e('js') }}');">
                          <input type="hidden" name="scheduler_action" value="delete">
                          <input type="hidden" name="cron_id" value="{{ task.cron_id }}">
                          <button class="btn btn-sm btn-danger" title="{{ text_action_delete }}"><i class="fa fa-trash"></i></button>
                        </form>
                        {% endif %}
                        <form action="" method="post" style="display:inline">
                          <input type="hidden" name="cron_id" value="{{ task.cron_id }}">
                          <input type="hidden" name="status" value="{{ task.status ? 0 : 1 }}">
                          <button type="submit" class="btn btn-sm nc-cron-toggle {{ task.status ? 'btn-warning' : 'btn-success' }}" title="{{ task.status ? button_disable : button_enable }}" aria-label="{{ task.status ? button_disable : button_enable }}"><i class="fa fa-{{ task.status ? 'pause' : 'check' }}" aria-hidden="true"></i></button>
                        </form>
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr><td colspan="9" class="text-center">{{ text_no_results }}</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    {% if history_task %}
    <div class="panel panel-default" id="task-history">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-history"></i> {{ text_task_history }}: {{ history_task.code }}</h3></div>
      <div class="panel-body">
        <div class="table-responsive"><table class="table table-bordered table-striped">
          <thead><tr><td>{{ column_started }}</td><td>{{ column_source }}</td><td>{{ column_run_status }}</td><td>{{ column_duration }}</td><td>{{ column_message }}</td></tr></thead>
          <tbody>
          {% for entry in task_history %}
            <tr><td>{{ entry.started_at }}</td><td>{{ entry.source_display }}</td>
            <td><span class="label label-{{ entry.status == 'success' ? 'success' : (entry.status == 'skipped' ? 'warning' : 'danger') }}">{{ entry.status_display }}</span></td>
            <td>{{ entry.duration_ms }} ms</td><td>{{ entry.message_display }}</td></tr>
          {% else %}
            <tr><td colspan="5" class="text-center">{{ text_task_history_empty }}</td></tr>
          {% endfor %}
          </tbody>
        </table></div>
      </div>
    </div>
    {% endif %}
    <div class="panel panel-default nc-queue-panel" id="queue-panel">
      <div class="panel-heading nc-queue-heading">
        <h3 class="panel-title"><i class="fa fa-tasks"></i> {{ text_queue_panel }}</h3>
        <div class="nc-queue-heading-actions">
          {% if can_modify %}
          <form action="" method="post" style="display:inline-block">
            <input type="hidden" name="scheduler_action" value="run_queue">
            <button class="btn btn-primary btn-sm"><i class="fa fa-play"></i> {{ text_queue_run }}</button>
          </form>
          {% endif %}
        </div>
      </div>
      <div class="panel-body">
        {% if can_modify %}<form action="" method="post" onsubmit="return confirm('{{ text_queue_cleanup_confirm|e('js') }}')" class="text-right">
          <input type="hidden" name="scheduler_action" value="purge_queue_done">
          <button type="submit" class="btn btn-default btn-sm"><i class="fa fa-trash"></i> {{ text_queue_cleanup }}</button>
        </form>{% endif %}
        <p>{{ text_queue_pending }}: {{ queue_stats.pending }}, {{ text_queue_processing }}: {{ queue_stats.processing }}, {{ text_queue_done }}: {{ queue_stats.done }}, {{ text_queue_failed }}: {{ queue_stats.failed }}</p>
        <form action="" method="get" class="nc-queue-filters">
          <input type="hidden" name="route" value="tool/cron">
          <input type="hidden" name="user_token" value="{{ user_token }}">
          <div class="nc-queue-search"><input name="queue_search" class="form-control" value="{{ queue_search }}" placeholder="{{ text_queue_search }}"></div>
          <div class="nc-queue-status"><select class="form-control" name="queue_status">
            {% for status in ['all','pending','processing','done','failed'] %}
            <option value="{{ status }}" {{ queue_status == status ? 'selected' : '' }}>{{ queue_status_labels[status] }}</option>
            {% endfor %}
          </select></div>
          <div class="nc-queue-limit"><select class="form-control" name="queue_limit">{% for item in [10,25,50,100] %}<option value="{{ item }}" {{ queue_limit == item ? 'selected' : '' }}>{{ item }}</option>{% endfor %}</select></div>
          <div class="nc-queue-submit"><button class="btn btn-primary" type="submit"><i class="fa fa-filter"></i> {{ text_queue_filter }}</button></div>
        </form>
      </div>
      <div class="nc-queue-table-wrap"><div class="table-responsive"><table class="table table-bordered table-hover nc-queue-table">
        <thead><tr><th><a href="{{ queue_sort_urls.queue_id }}">ID</a></th><th><a href="{{ queue_sort_urls.code }}">{{ column_code }}</a></th><th><a href="{{ queue_sort_urls.route }}">{{ column_route }}</a></th><th><a href="{{ queue_sort_urls.status }}">{{ column_status }}</a></th><th><a href="{{ queue_sort_urls.attempts }}">{{ text_queue_attempts }}</a></th><th><a href="{{ queue_sort_urls.available_at }}">{{ text_queue_available }}</a></th><th>{{ text_queue_locked }}</th><th>{{ text_queue_error }}</th><th>{{ column_action }}</th></tr></thead>
        <tbody>{% for item in queue_jobs %}
          <tr><td>{{ item.queue_id }}</td><td>{{ item.code }}</td><td><code>{{ item.route }}</code></td><td><span class="label label-{{ item.status == 'done' ? 'success' : (item.status == 'failed' ? 'danger' : (item.status == 'processing' ? 'info' : 'warning')) }}">{{ queue_status_labels[item.status]|default(item.status) }}</span></td><td>{{ item.attempts }}/{{ item.max_attempts }}</td><td>{{ item.available_at }}</td><td>{{ item.locked_at ?: '—' }}</td><td>{{ item.last_error ?: '—' }}</td><td class="text-right" style="white-space:nowrap">
            {% if can_modify %}
              {% if item.status in ['pending','failed'] %}
              <form action="" method="post" style="display:inline-block">
                <input type="hidden" name="scheduler_action" value="run_queue_one">
                <input type="hidden" name="queue_id" value="{{ item.queue_id }}">
                <input type="hidden" name="retry" value="{{ item.status == 'failed' ? 1 : 0 }}">
                <button class="btn btn-sm btn-primary" title="{{ item.status == 'failed' ? text_queue_retry : text_action_run }}"><i class="fa fa-{{ item.status == 'failed' ? 'repeat' : 'play' }}"></i></button>
              </form>
              {% endif %}
              {% if item.status != 'processing' %}
              <form action="" method="post" style="display:inline-block" onsubmit="return confirm('{{ text_queue_confirm_delete|e('js') }}');">
                <input type="hidden" name="scheduler_action" value="delete_queue_one">
                <input type="hidden" name="queue_id" value="{{ item.queue_id }}">
                <button class="btn btn-sm btn-danger" title="{{ text_action_delete }}"><i class="fa fa-trash"></i></button>
              </form>
              {% endif %}
            {% endif %}
          </td></tr>
          {% else %}<tr><td colspan="9" class="text-center nc-queue-empty">{{ text_no_results }}</td></tr>
        {% endfor %}</tbody>
      </table></div></div>
      <div class="panel-footer text-right">{{ queue_pagination }}</div>
    </div>
    {% if can_modify %}
    <div class="panel panel-default" id="scheduler-form">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-plus"></i> {{ edit_task.cron_id ? text_action_edit : text_action_add }}</h3></div>
      <div class="panel-body">
        <form action="" method="post" class="form-horizontal" id="nc-scheduler-form" novalidate>
          <input type="hidden" name="scheduler_action" value="save">
          <input type="hidden" name="cron_id" value="{{ edit_task.cron_id }}">
          <div class="form-group required"><label class="col-sm-2 control-label">{{ text_action_code }}</label><div class="col-sm-10"><input class="form-control" id="input-cron-code" name="code" required minlength="2" maxlength="128" value="{{ edit_task.code }}" {{ edit_task.code|slice(0, 5) == 'core.' ? 'readonly' : '' }}></div></div>
          <div class="form-group required"><label class="col-sm-2 control-label">{{ text_action_route }}</label><div class="col-sm-10"><input class="form-control" id="input-cron-route" name="route" list="nc-cron-handlers" required value="{{ edit_task.route }}" placeholder="cron/example" autocomplete="off"><datalist id="nc-cron-handlers">{% for handler in cron_handlers %}<option value="{{ handler }}"></option>{% endfor %}</datalist><small class="help-block">{{ text_cron_handler_hint }}</small></div></div>
          <div class="form-group"><label class="col-sm-2 control-label">{{ text_schedule_mode }}</label>
            <div class="col-sm-10"><select id="nc-schedule-mode" name="schedule_mode" class="form-control">
              <option value="interval" {{ not edit_task.cron_expression ? 'selected' : '' }}>{{ text_schedule_interval }}</option>
              <option value="cron" {{ edit_task.cron_expression ? 'selected' : '' }}>{{ text_schedule_cron }}</option>
            </select></div>
          </div>
          <div class="form-group" id="nc-cron-expression-row"><label class="col-sm-2 control-label">{{ text_cron_expression }}</label>
            <div class="col-sm-10">
              <input class="form-control" id="nc-cron-expression" name="cron_expression" value="{{ edit_task.cron_expression }}" placeholder="0 3 * * *" maxlength="100">
              <small class="help-block">{{ text_cron_example }}</small>
              <button type="button" id="nc-cron-preview-btn" class="btn btn-default btn-sm">{{ text_cron_preview }}</button>
              <div id="nc-cron-preview-results" aria-live="polite"></div>
            </div>
          </div>
          <div id="nc-interval-row">
          <div class="form-group required"><label class="col-sm-2 control-label">{{ text_action_interval }}</label><div class="col-sm-10">
            <input class="form-control" id="input-cron-interval" type="number" name="interval_seconds" min="60" max="31536000" required value="{{ edit_task.interval_seconds }}">
            <div class="nc-interval-calc">
              <div class="nc-interval-fields">
                <label class="nc-interval-field"><span>{{ text_interval_years }}</span><input class="form-control nc-interval-part" type="number" min="0" max="525600" step="1" value="0" data-seconds="31536000" aria-label="{{ text_interval_years }}"></label>
                <label class="nc-interval-field"><span>{{ text_interval_months }}</span><input class="form-control nc-interval-part" type="number" min="0" max="525600" step="1" value="0" data-seconds="2592000" aria-label="{{ text_interval_months }}"></label>
                <label class="nc-interval-field"><span>{{ text_interval_weeks }}</span><input class="form-control nc-interval-part" type="number" min="0" max="525600" step="1" value="0" data-seconds="604800" aria-label="{{ text_interval_weeks }}"></label>
                <label class="nc-interval-field"><span>{{ text_interval_days }}</span><input class="form-control nc-interval-part" type="number" min="0" max="525600" step="1" value="0" data-seconds="86400" aria-label="{{ text_interval_days }}"></label>
                <label class="nc-interval-field"><span>{{ text_interval_hours }}</span><input class="form-control nc-interval-part" type="number" min="0" max="525600" step="1" value="0" data-seconds="3600" aria-label="{{ text_interval_hours }}"></label>
                <label class="nc-interval-field"><span>{{ text_interval_minutes }}</span><input class="form-control nc-interval-part" type="number" min="0" max="525600" step="1" value="0" data-seconds="60" aria-label="{{ text_interval_minutes }}"></label>
              </div>
              <div class="nc-interval-actions"><span id="nc-interval-preview" class="nc-interval-preview" aria-live="polite">0 {{ text_interval_seconds }}</span><button id="nc-interval-apply" class="btn btn-default" type="button" disabled><i class="fa fa-arrow-up"></i> {{ text_interval_apply }}</button></div>
              <small class="help-block">{{ text_interval_assumptions }}</small>
            </div>
          </div></div>
          </div>
          <div class="form-group"><label class="col-sm-2 control-label">{{ text_misfire_policy }}</label><div class="col-sm-10">
            <select class="form-control" name="misfire_policy">
              <option value="run_once" {{ edit_task.misfire_policy|default('run_once') == 'run_once' ? 'selected' : '' }}>{{ text_misfire_run_once }}</option>
              <option value="skip" {{ edit_task.misfire_policy|default('run_once') == 'skip' ? 'selected' : '' }}>{{ text_misfire_skip }}</option>
            </select><small class="help-block">{{ text_misfire_help }}</small>
          </div></div>
          <div class="form-group"><label class="col-sm-2 control-label">{{ text_action_args }}</label><div class="col-sm-10"><textarea class="form-control" name="args" rows="3">{{ edit_task.args }}</textarea></div></div>
          <div class="form-group"><label class="col-sm-2 control-label">{{ column_status }}</label><div class="col-sm-10"><select class="form-control" name="status"><option value="1" {{ edit_task.status ? 'selected' : '' }}>{{ text_enabled }}</option><option value="0" {{ not edit_task.status ? 'selected' : '' }}>{{ text_disabled }}</option></select></div></div>
          <div class="text-right"><a class="btn btn-default" href="{{ action }}">{{ text_action_cancel }}</a> <button class="btn btn-primary" type="submit"><i class="fa fa-save"></i> {{ text_action_save }}</button></div>
        </form>
      </div>
    </div>
    {% endif %}
  </div>
</div>
{{ footer }}
<script>
(function () {
  var mode = document.getElementById('nc-schedule-mode');
  if (!mode) { return; }
  var intervalRow = document.getElementById('nc-interval-row');
  var cronRow = document.getElementById('nc-cron-expression-row');
  var interval = document.getElementById('input-cron-interval');
  var expression = document.getElementById('nc-cron-expression');
  var results = document.getElementById('nc-cron-preview-results');
  function toggle() {
    var cron = mode.value === 'cron';
    intervalRow.style.display = cron ? 'none' : '';
    cronRow.style.display = cron ? '' : 'none';
    interval.required = !cron;
    expression.required = cron;
  }
  var form = document.getElementById('nc-scheduler-form');
  var fields = [
    { node: document.getElementById('input-cron-code'), check: function (v) { return v.length >= 2 && v.length <= 128 && /^[a-z0-9_.:-]+$/i.test(v); } },
    { node: document.getElementById('input-cron-route'), check: function (v) { return new RegExp('^cron/[a-z0-9_/]+$', 'i').test(v); } },
    { node: interval, check: function (v) { return /^[0-9]+$/.test(v) && Number(v) >= 60 && Number(v) <= 31536000; }, mode: 'interval' },
    { node: expression, check: function (v) { return v.length > 0; }, mode: 'cron' }
  ];
  function showError(field, invalid) {
    var group = field.node.closest('.form-group');
    if (!group) { return; }
    var feedback = group.querySelector('.nc-field-error');
    if (!feedback) {
      feedback = document.createElement('div');
      feedback.className = 'text-danger nc-field-error';
      field.node.parentNode.insertBefore(feedback, field.node.nextSibling);
    }
    group.classList.toggle('has-error', invalid);
    feedback.textContent = invalid ? {{ text_cron_required_error|json_encode|raw }} : '';
  }
  function check(field) {
    if (field.mode && field.mode !== mode.value) { showError(field, false); return true; }
    var valid = field.check(field.node.value.trim());
    showError(field, !valid);
    return valid;
  }
  fields.forEach(function (field) {
    field.node.addEventListener('input', function () {
      if (form.dataset.validated === 'yes' || field.node.closest('.form-group').classList.contains('has-error')) check(field);
    });
    field.node.addEventListener('blur', function () { if (field.node.value.trim() !== '') check(field); });
  });
  form.addEventListener('submit', function (event) {
    form.dataset.validated = 'yes';
    var first = null;
    fields.forEach(function (field) { if (!check(field) && !first) first = field.node; });
    if (first) { event.preventDefault(); first.focus(); }
  });
  mode.addEventListener('change', function () { toggle(); fields.forEach(function (field) { showError(field, false); }); });
  toggle();
  document.getElementById('nc-cron-preview-btn').addEventListener('click', function () {
    results.textContent = '...';
    $.ajax({
      url: {{ cron_preview_url|json_encode|raw }},
      type: 'GET',
      dataType: 'json',
      data: { expression: expression.value },
      cache: false
    }).done(function (data) {
      results.textContent = data.error ? data.error : (data.dates || []).join('  ·  ');
    }).fail(function (xhr, status, error) {
      var message = (xhr.responseJSON && xhr.responseJSON.error) || '';
      if (!message && xhr.responseText) {
        var plain = $('<div>').html(xhr.responseText).text().replace(/\s+/g, ' ').trim();
        message = plain.substring(0, 240);
      }
      results.textContent = {{ text_cron_preview_failed|json_encode|raw }} + ' (HTTP ' + xhr.status + ', ' + status + ')' +
        (message ? ': ' + message : (error ? ': ' + error : ''));
    });
  });
})();
</script>



<script type="text/javascript">
(function () {
    // Use the browser's canonical URL; OpenCart-generated links may redirect HTTP to HTTPS.
    var url = window.location.href.split('#')[0];
    var busy = false;
    window.setInterval(function () {
        if (busy || document.hidden || !document.getElementById('jobs-monitor')) {
            return;
        }
        busy = true;
        $.ajax({
            url: url,
            type: 'GET',
            cache: false,
            success: function (html) {
                var parsed = new DOMParser().parseFromString(html, 'text/html');
                var updated = parsed.getElementById('jobs-monitor');
                if (updated) {
                    var currentHistory = document.getElementById('jobs-monitor-history');
                    var historyOpen = currentHistory && currentHistory.open;
                    document.getElementById('jobs-monitor').innerHTML = updated.innerHTML;
                    var newHistory = document.getElementById('jobs-monitor-history');
                    if (newHistory) newHistory.open = !!historyOpen;
                } else {
                    console.warn('NovaCart monitor refresh: response does not contain #jobs-monitor');
                }
            },
            error: function (xhr, status) {
                console.warn('NovaCart monitor refresh failed:', status, xhr.status);
            },
            complete: function () { busy = false; }
        });
    }, 30000);
})();
</script>

<script type="text/javascript">
$('.js-cron-copy').on('click', function () {
    var node = document.getElementById($(this).attr('data-copy'));
    if (!node) return;
    var command = node.textContent.trim();
    if (!command) return;
    function copyFallback() {
        var area = document.createElement('textarea');
        area.value = command;
        area.style.position = 'fixed';
        area.style.top = '0';
        area.style.left = '0';
        document.body.appendChild(area);
        area.focus();
        area.select();
        var ok = document.execCommand('copy');
        document.body.removeChild(area);
        if (!ok) window.prompt('Copy command:', command);
    }
    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(command).catch(copyFallback);
    } else {
        copyFallback();
    }
});
</script>

<script type="text/javascript">
(function () {
    var fields = document.querySelectorAll('.nc-interval-part');
    var preview = document.getElementById('nc-interval-preview');
    var apply = document.getElementById('nc-interval-apply');
    var target = document.getElementById('input-cron-interval');
    if (!fields.length || !preview || !apply || !target) return;
    function calculate() {
        var seconds = 0;
        var valid = true;
        Array.prototype.forEach.call(fields, function (field) {
            var raw = field.value.trim();
            var value = Number(raw);
            if (raw === '' || !Number.isSafeInteger(value) || value < 0) valid = false;
            seconds += value * Number(field.getAttribute('data-seconds'));
        });
        valid = valid && Number.isSafeInteger(seconds) && seconds >= 60 && seconds <= 31536000;
        preview.textContent = valid ? seconds + ' {{ text_interval_seconds|e('js') }}' : '{{ text_interval_invalid|e('js') }}';
        apply.disabled = !valid;
        return valid ? seconds : null;
    }
    Array.prototype.forEach.call(fields, function (field) { field.addEventListener('input', calculate); });
    apply.addEventListener('click', function () {
        var seconds = calculate();
        if (seconds !== null) {
            target.value = seconds;
            target.dispatchEvent(new Event('change', { bubbles: true }));
        }
    });
    calculate();
})();
</script>
