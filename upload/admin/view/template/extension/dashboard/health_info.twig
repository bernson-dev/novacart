<div class="panel panel-default nc-health">
  <div class="panel-heading clearfix">
    <h3 class="panel-title pull-left"><i class="fa fa-heartbeat"></i> {{ heading_title }}</h3>
    <a href="{{ settings }}" class="btn btn-default btn-xs pull-right" title="{{ text_settings }}"><i class="fa fa-cog"></i></a>
  </div>
  <div class="panel-body">
    <div class="nc-health-overview">
      <div class="nc-health-metric nc-health-metric-ok"><i class="fa fa-check-circle"></i><span class="nc-health-metric-number">{{ summary.ok }}</span><span>{{ state_ok }}</span></div>
      <div class="nc-health-metric nc-health-metric-warning"><i class="fa fa-exclamation-triangle"></i><span class="nc-health-metric-number">{{ summary.warning }}</span><span>{{ state_warning }}</span></div>
      <div class="nc-health-metric nc-health-metric-error"><i class="fa fa-times-circle"></i><span class="nc-health-metric-number">{{ summary.error }}</span><span>{{ state_error }}</span></div>
    </div>
    <div class="nc-health-actions">
      {% for action in quick_actions %}
        <a href="{{ action.href }}" class="btn btn-default"><i class="fa {{ action.icon }}"></i> {{ action.label }}</a>
      {% endfor %}
    </div>
    <section class="nc-health-attention">
      <h4><i class="fa fa-exclamation-triangle"></i> {{ text_attention }} <span class="label label-default">{{ attention|length }}</span></h4>
      {% if attention %}
      <div class="nc-health-attention-list">
        {% for item in attention %}
        <div class="nc-health-attention-item nc-health-attention-{{ item.class }}">
          <span class="label label-{{ item.class }}">{{ item.state_text }}</span>
          <span class="nc-health-check-name">{{ item.label }}</span>
          {% if item.value is not same as('') %}<strong>{{ item.value }}</strong>{% endif %}
          {% if item.href %}<a href="{{ item.href }}">{{ text_view }} <i class="fa fa-angle-right"></i></a>{% endif %}
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p class="text-success"><i class="fa fa-check-circle"></i> {{ text_no_attention }}</p>
      {% endif %}
    </section>
    <div class="row nc-health-sections">
      {% for section in sections %}
      {% set section_warning = 0 %}
      {% set section_error = 0 %}
      {% for item in section.items %}
        {% if item.state == 'warning' %}{% set section_warning = section_warning + 1 %}{% endif %}
        {% if item.state == 'error' %}{% set section_error = section_error + 1 %}{% endif %}
      {% endfor %}
      <div class="col-lg-6 col-md-6 col-sm-12">
        <div class="nc-health-section">
          <div class="nc-health-section-heading">
            <span><i class="fa {{ section.icon }}"></i> {{ section.title }}</span>
            <span class="nc-health-section-summary">
              {% if section_error %}<span class="label label-danger">{{ section_error }}</span>{% endif %}
              {% if section_warning %}<span class="label label-warning">{{ section_warning }}</span>{% endif %}
              {% if not section_warning and not section_error %}<i class="fa fa-check-circle text-success"></i>{% endif %}
            </span>
          </div>
          <div class="nc-health-section-body">
            {% for item in section.items %}
            <details class="nc-health-check" {% if item.state == 'error' %}open{% endif %}>
              <summary>
                <span class="nc-health-check-name"><i class="fa fa-circle nc-health-dot nc-health-dot-{{ item.class }}"></i> {{ item.label }}</span>
                <span class="nc-health-check-value">{{ item.value }}</span>
                <span class="label label-{{ item.class }}">{{ item.state_text }}</span>
                <i class="fa fa-angle-down nc-health-expand"></i>
              </summary>
              <div class="nc-health-check-details">
                <p>{{ item.help }}</p>
                {% if item.details %}
                <ul class="list-unstyled">
                  {% for detail in item.details %}
                  <li><span class="label label-default">{{ detail.label }}</span> <code>{{ detail.path }}</code></li>
                  {% endfor %}
                </ul>
                {% endif %}
                {% if item.href %}<a href="{{ item.href }}">{{ text_view }} <i class="fa fa-angle-right"></i></a>{% endif %}
              </div>
            </details>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
