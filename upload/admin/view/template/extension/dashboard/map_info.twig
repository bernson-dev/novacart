{% if map_type == 'ukraine_geo' %}
<div class="panel panel-default novacart-world-map-panel">
    <div class="panel-heading">
        <h3 class="panel-title">
            <i class="fa fa-map"></i> {{ heading_title }}</h3></div>
    <div class="panel-body novacart-country-orders">
        <p class="text-muted small text-center">{{ text_map_ukraine_geo }}</p>
        <div id="novacart-ukraine-geo-map" class="novacart-world-map" aria-label="{{ heading_title }}"></div>

        {% if regions %}
        <div class="table-responsive novacart-world-map-table">
            <table class="table table-condensed table-hover">
                <thead>
                    <tr>
                        <th>{{ text_region }}</th>
                        <th class="text-right">{{ text_order }}</th>
                        <th class="text-right">{{ text_sale }}</th></tr></thead>
                <tbody>
                    {% for region in regions %}
                    <tr data-region="{{ region.name }}">
                        <td>{{ region.name }}</td>
                        <td class="text-right">{{ region.total }}</td>
                        <td class="text-right">{{ region.amount }}</td></tr>{% endfor %}
                </tbody></table></div>
        {% else %}
        <p class="text-muted text-center">{{ text_no_data }}</p>{% endif %}
    </div></div>
<link href="view/stylesheet/dashboard/map-ukraine-geo.css" type="text/css" rel="stylesheet" />
<script>(function() {
        var el=document.getElementById('novacart-ukraine-geo-map');
        if (!el||!window.NovaCartUkraineGeography)
            return;
        window.NovaCartUkraineGeography.render(el,{values:{{ map_values_json|raw }},zoomIn:{{ text_zoom_in|json_encode|raw }},zoomOut:{{ text_zoom_out|json_encode|raw }},reset:{{ text_map_reset|json_encode|raw }}});
        el.addEventListener('novacart:regionselect',function(e) {
            var rows=document.querySelectorAll('.novacart-world-map-table tr[data-region]');
            for (var i=0;i<rows.length;i++) {
                rows[i].classList.toggle('is-selected',!!e.detail&&window.NovaCartUkraineMap.normalize(rows[i].getAttribute('data-region'))===e.detail.code);
            }
        });})(); </script>
{% elseif map_type == 'ukraine' %}
<div class="panel panel-default novacart-world-map-panel">
    <div class="panel-heading">
        <h3 class="panel-title">
            <i class="fa fa-map"></i> {{ heading_title }}</h3></div>
    <div class="panel-body novacart-country-orders">
        <div id="novacart-ukraine-map" class="novacart-world-map" aria-label="{{ heading_title }}"></div>
        <p class="text-muted small text-center">{{ text_map_ukraine }} — {{ text_map_schematic }}</p>
        {% if regions %}
        <div class="table-responsive novacart-world-map-table">
            <table class="table table-condensed table-hover">
                <thead>
                    <tr>
                        <th>{{ text_region }}</th>
                        <th class="text-right">{{ text_order }}</th>
                        <th class="text-right">{{ text_sale }}</th></tr></thead>
                <tbody>
                    {% for region in regions %}
                    <tr data-region="{{ region.name }}">
                        <td>{{ region.name }}</td>
                        <td class="text-right">{{ region.total }}</td>
                        <td class="text-right">{{ region.amount }}</td></tr>{% endfor %}
                </tbody></table></div>
        {% else %}
        <p class="text-muted text-center">{{ text_no_data }}</p>{% endif %}
    </div></div>
<link href="view/stylesheet/dashboard/map-ukraine.css" type="text/css" rel="stylesheet" />
<script>(function() {
        var el=document.getElementById('novacart-ukraine-map');
        if (!el||!window.NovaCartUkraineMap)
            return;
        window.NovaCartUkraineMap.render(el,{values:{{ map_values_json|raw }},zoomIn:{{ text_zoom_in|json_encode|raw }},zoomOut:{{ text_zoom_out|json_encode|raw }},reset:{{ text_map_reset|json_encode|raw }}});
        el.addEventListener('novacart:regionselect',function(e) {
            var rows=document.querySelectorAll('.novacart-world-map-table tr[data-region]');
            for (var i=0;i<rows.length;i++) {
                rows[i].classList.toggle('is-selected',!!e.detail&&window.NovaCartUkraineMap.normalize(rows[i].getAttribute('data-region'))===e.detail.code);
            }
        });})(); </script>
{% else %}
<div class="panel panel-default novacart-world-map-panel">
    <div class="panel-heading">
        <h3 class="panel-title">
            <i class="fa fa-globe"></i> {{ heading_title }}</h3>
    </div>
    <div class="panel-body novacart-country-orders">
        <div id="novacart-world-map" class="novacart-world-map" aria-label="{{ heading_title }}"></div>
        {% if countries %}
        <div class="table-responsive novacart-world-map-table">
            <table class="table table-condensed table-hover">
                <thead>
                    <tr>
                        <th>{{ text_country }}</th>
                        <th class="text-right">{{ text_order }}</th>
                        <th class="text-right">{{ text_sale }}</th></tr></thead>
                <tbody>{% for country in countries|slice(0, 8) %}
                    <tr data-country="{{ country.iso_code_2|lower }}">
                        <td>
                            <strong>{{ country.iso_code_2 }}</strong> {{ country.name }}</td>
                        <td class="text-right">{{ country.total }}</td>
                        <td class="text-right">{{ country.amount }}</td></tr>{% endfor %}</tbody>
            </table>
        </div>
        {% else %}
        <p class="text-muted text-center novacart-world-map-empty">{{ text_no_data }}</p>{% endif %}
    </div>
</div>
<link href="view/stylesheet/dashboard/map-world.css" type="text/css" rel="stylesheet" />
<script type="text/javascript">
    (function() {
        var el=document.getElementById('novacart-world-map');
        if (!el||!window.NovaCartWorldMap) {
            return;
        }
        window.NovaCartWorldMap.render(el,{
            values:{{ map_values_json|raw }},
            label:{{ heading_title|json_encode|raw }},
            controlsLabel:{{ text_map_controls|json_encode|raw }},
            zoomInLabel:{{ text_zoom_in|json_encode|raw }},
            zoomOutLabel:{{ text_zoom_out|json_encode|raw }},
            resetLabel:{{ text_map_reset|json_encode|raw }}
        });
        el.addEventListener('novacart:mapselect',function(event) {
            var rows=document.querySelectorAll('.novacart-world-map-table tr[data-country]');
            for (var i=0;i<rows.length;i++) {
                rows[i].classList.toggle('is-selected',!!event.detail&&rows[i].getAttribute('data-country')===event.detail.code);
            }
        });
    })();
</script>

{% endif %}
