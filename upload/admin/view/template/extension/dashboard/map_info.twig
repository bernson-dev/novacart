{% if map_type == 'ukraine_geo' %}
<div class="panel panel-default novacart-world-map-panel">
    <div class="panel-heading">
        <h3 class="panel-title">
            <i class="fa fa-map"></i> {{ heading_title }}</h3></div>
    <div class="panel-body novacart-country-orders">
        <p class="text-muted small text-center">{{ text_map_ukraine_geo }}</p>
        <div id="novacart-ukraine-geo-map" class="novacart-world-map" aria-label="{{ heading_title }}"></div>

        {% if regions %}
        <div class="table-responsive novacart-world-map-table">
            <table class="table table-condensed table-hover">
                <thead>
                    <tr>
                        <th>{{ text_region }}</th>
                        <th class="text-right">{{ text_order }}</th>
                        <th class="text-right">{{ text_sale }}</th></tr></thead>
                <tbody>
                    {% for region in regions %}
                    <tr data-region="{{ region.name }}">
                        <td>{{ region.name }}</td>
                        <td class="text-right">{{ region.total }}</td>
                        <td class="text-right">{{ region.amount }}</td></tr>{% endfor %}
                </tbody></table></div>
        {% else %}
        <p class="text-muted text-center">{{ text_no_data }}</p>{% endif %}
    </div></div>
<style>
    .novacart-world-map{
        position: relative;
    height: 320px;
    min-height: 230px;
    border: 1px solid #e3eaf2;
    border-radius: 9px;
    background: #f8fbff;
    overflow: hidden;
    touch-action: none
    }
    .novacart-world-map-table{
        margin-top: 12px
    }
    .novacart-world-map-table tr.is-selected>td{
        background: #eaf4ff
    }.ua-map-tooltip{
        position: absolute;
    pointer-events: none;
    padding: 5px 8px;
    border-radius: 5px;
    background: #263544;
    color: #fff;
    font-size: 12px;
    z-index: 5
    }.ua-map-btn{
        position: absolute;
    top: 8px;
    left: 8px;
    z-index: 3;
    border: 1px solid #cfd9e5;
    border-radius: 5px;
    background: white;
    padding: 4px 9px
    }.ua-map-btn + .ua-map-btn{
        top: 42px
    }.ua-map-btn + .ua-map-btn + .ua-map-btn{
        top: 76px
    }@media(max-width:767px){
        .novacart-world-map{
            height: 270px
        }
    }</style>
<script>(function() {
        var el=document.getElementById('novacart-ukraine-geo-map');
        if (!el||!window.NovaCartUkraineGeography)
            return;
        window.NovaCartUkraineGeography.render(el,{values:{{ map_values_json|raw }},zoomIn:{{ text_zoom_in|json_encode|raw }},zoomOut:{{ text_zoom_out|json_encode|raw }},reset:{{ text_map_reset|json_encode|raw }}});
        el.addEventListener('novacart:regionselect',function(e) {
            var rows=document.querySelectorAll('.novacart-world-map-table tr[data-region]');
            for (var i=0;i<rows.length;i++) {
                rows[i].classList.toggle('is-selected',!!e.detail&&window.NovaCartUkraineMap.normalize(rows[i].getAttribute('data-region'))===e.detail.code);
            }
        });})(); </script>
