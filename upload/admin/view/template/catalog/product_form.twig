        }
        /* иконка-ручка слева */
        .drag-hint {
            display: inline-block;
            width: 20px;
            text-align: center;
            color: #999;
            margin-right: 5px;
            opacity: 0.5;
            transition: opacity 0.2s, transform 0.2s;
        }
        tbody[data-role="sortable-list"] tr:hover .drag-hint {
            opacity: 1;
            transform: scale(1.1);
        }
        /* строка во время перетаскивания */
