    <!-- ИЗОБРАЖЕНИЯ -->
    <!-- ЛОГИКА ВСТАВКИ ИЗОБРАЖЕНИЙ ИЗ FILE MANAGER -->
    <script>
        // Получения картинок из FileManager
        window.insertSelectedImages = function(imagesData) {
            const input = document.getElementById('input-image');
            const thumb = document.querySelector('#thumb-image img');

            // Если главное изображение пустое — ставим первую картинку туда
            if (input && thumb && input.value.trim() === '' && imagesData.length >= 1) {
                const firstImage = imagesData.shift();
                input.value = firstImage.fullUrl;
                thumb.src = firstImage.thumbUrl;
                thumb.alt = firstImage.fileName;
                thumb.title = firstImage.fileName;
            }

            // Если есть ещё картинки — вставляем в доплнительные
            if (imagesData.length > 0) {
                insertSelectedImages_product(imagesData);
            }
        };

        // Вставка в дополнительные изображения
        window.insertSelectedImages_product = function(imagesData) {
            const tbody = document.querySelector('tbody[data-role="sortable-list"]');
            const placeholder = '{{ placeholder|escape('js') }}';

            let imageRow = tbody.querySelectorAll('tr').length;

            imagesData.forEach(function(item) {
                // Ищем первую пустую строку в таблице
                const emptyRow = Array.from(tbody.querySelectorAll('tr')).find(tr => {
                    const input = tr.querySelector('input[name*="[image]"]');
                    return input && !input.value.trim();
                });

                if (emptyRow) {
                    const index = emptyRow.id.replace('image-row', '');
                    const thumb = emptyRow.querySelector(`#thumb-image${index} img`);
                    const input = emptyRow.querySelector(`#input-image${index}`);
                    const sort = emptyRow.querySelector(`input[name*="[sort_order]"]`);

                    if (thumb) {
                        thumb.src = item.thumbUrl;
                        thumb.alt = item.fileName;
                        thumb.title = item.fileName;
                    }
                    if (input)
                        input.value = item.fullUrl;
                    if (sort)
                        sort.value = index;
                } else {
                    // Если пустой строки нет — создаём новую
                    const html = `
            <tr id="image-row${imageRow}">
                <td class="text-left">
                    <span class="drag-hint" title="{{ text_drag }}">
                        <i class="fa fa-arrows-alt"></i>
                    </span>
                    <a href="" id="thumb-image${imageRow}" data-toggle="image" class="img-thumbnail">
                        <img src="${item.thumbUrl}" alt="${item.fileName}" title="${item.fileName}" data-placeholder="${placeholder}" />
                    </a>
                    <input type="hidden" name="product_image[${imageRow}][image]" value="${item.fullUrl}" id="input-image${imageRow}" />
                </td>
                <td class="text-right">
                    <input type="text" name="product_image[${imageRow}][sort_order]" value="${imageRow}" class="form-control sort-order-input" readonly />
                </td>
                <td class="text-center">
                    <button type="button" onclick="removeImageRow('image-row${imageRow}')" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger">
                        <i class="fa fa-minus-circle"></i>
                    </button>
                </td>
            </tr>`;
                    tbody.insertAdjacentHTML('beforeend', html);
                    imageRow++;
                }
            });

            renumberRows();
            $('[data-toggle="tooltip"]').tooltip({ container: 'body' });
        };
    </script>

    <!-- КНОПКА "Добавить изображение" -->
