            opacity: 0.7;
            background: #eaf5ff;
            box-shadow: inset 0 0 6px rgba(0,0,0,0.15);
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tbody = document.querySelector('tbody[data-role="sortable-list"]');
            if (tbody) {
                // --- Автоматическая нумерация при загрузке ---
                let needsRenumber = false;
                tbody.querySelectorAll('.sort-order-input').forEach((input, index) => {
                    if (!input.value || input.value === '0') {
                        needsRenumber = true;
                    }
                });
                if (needsRenumber) {
                    renumberRows();
                }
                // --- Sortable для drag&drop ---
                if (typeof Sortable !== 'undefined') {
                    new Sortable(tbody, {
                        animation: 150,
                        ghostClass: 'sortable-ghost',
                        onEnd: renumberRows
                    });
                }
                // --- Двойной клик для ручного редактирования ---
                tbody.addEventListener('dblclick', function (e) {
                    if (e.target.classList.contains('sort-order-input')) {
                        e.target.removeAttribute('readonly');
                        e.target.focus();
                    }
                });
                tbody.addEventListener('focusout', function (e) {
                    if (e.target.classList.contains('sort-order-input')) {
                        e.target.setAttribute('readonly', 'readonly');

                        const v = parseInt(e.target.value, 10);
                        e.target.value = Number.isFinite(v) ? v : 1; // 0 или 1, если начинаете с 1
                    }
                });
            }
        });
        function renumberRows() {
            const tbody = document.querySelector('tbody[data-role="sortable-list"]');
            if (!tbody)
                return;
            Array.from(tbody.querySelectorAll('tr')).forEach((row, index) => {
                const input = row.querySelector('.sort-order-input');
                if (input)
                    input.value = index+1;
            });
        }
        function removeImageRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
                renumberRows(); // пересчёт после удаления
            }
        }
        function removeRecurringRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
            }
        }
        function removeDiscountRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
            }
        }
        function removeSpecialRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
            }
        }
    </script>
