    <script>
        $(document).ready(function() {
            $(document).on('click', '#fill-empty-fields', function() {
                const actionUrl = new URL($('#form-product').attr('action'), window.location.origin);
                const productId = parseInt(actionUrl.searchParams.get('product_id'), 10);

                if (isNaN(productId)) {
                    alert('{{ error_product_not_found }}');
                    return;
                }

                const fieldLabels = {
                    'name': '{{ text_name }}',
                    'meta_title': '{{ text_meta_title }}',
                    'meta_h1': '{{ text_meta_h1 }}',
                    'description': '{{ text_description }}',
                    'meta_description': '{{ text_meta_description }}',
                    'meta_keyword': '{{ text_meta_keywords }}',
                    'tag': '{{ text_tags }}'
                };

                $.ajax({
                    url: 'index.php?route=catalog/product/fillEmptyFields&user_token={{ user_token }}',
                    type: 'post',
                    data: { product_id: productId },
                    dataType: 'json',
                    success: function(r) {
                        let title = r.success ? (r.copied ? '✅ {{ text_success_ui }}' : 'ℹ️ {{ text_nothing_copied }}') : '❌ {{ text_error }}';
                        let body = `<p>${r.message}</p>`;

                        if (r.filled_languages_stats && r.source_language) {
                            body += '<p style="margin-top: 15px; font-size:12px; color:#777; font-weight: bold;">{{ text_before_copy }}:</p>';
                            body += '<ul style="margin: 8px 0 0 20px; font-size:12px; color:#555;">';
                            for (const code in r.filled_languages_stats) {
                                if (r.filled_languages_stats.hasOwnProperty(code)) {
                                    const count = r.filled_languages_stats[code];
                                    const languageName = code.toUpperCase();
                                    if (code === r.source_language.code.toLowerCase()) {
                                        body += `<li>${languageName}: ${count} {{ text_source_language }}</li>`;
                                    } else {
                                        body += `<li>${languageName}: ${count}</li>`;
                                    }
                                }
                            }
                            body += '</ul>';
                        }

                        if (r.copied_fields && r.copied_fields.length > 0) {
                            body += '<p style="margin-top: 15px; font-size:12px; color:#777; font-weight: bold;">{{ text_copied_fields }}:</p>';
                            body += '<ul style="margin: 8px 0 0 20px; font-size:13px; color:#555;">';

                            r.copied_fields.forEach(item => {
                                const fieldName = item.field;
                                const languages = item.languages.join(', ').toUpperCase();
                                const label = fieldLabels[fieldName] || fieldName;
                                body += `<li>📄 ${label} → ${languages}</li>`;
                            });

                            body += '</ul>';
                        }

                        const modal = document.createElement('div');
                        modal.innerHTML = `
                    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);display:flex;justify-content:center;align-items:center;z-index:9999;">
                        <div style="background:white;padding:24px;border-radius:8px;max-width:450px;font-family:Arial,sans-serif;">
                            <h3 style="margin:0 0 16px 0; color:#333;">${title}</h3>
                            <div style="color:#444;">${body}</div>
                            <button onclick="
                                this.closest('div').parentElement.remove();
                                window.location.href = window.location.pathname + window.location.search;
                            " style="
                                margin-top:20px;
                                padding:10px 20px;
                                background:#007bff;
                                color:white;
                                border:none;
                                border-radius:4px;
                                cursor:pointer;
                                font-size:14px;
                            ">
                                {{ text_close_and_refresh }}
                            </button>
                        </div>
                    </div>
                    `;
                        document.body.appendChild(modal);
                    },
                    error: function() {
                        alert('{{ error_request }}');
                    }
                });
            });
        });
    </script>

    <script>
        $('#language a:first').tab('show');
        $('#option a:first').tab('show');
    </script>

    <script>
        (function () {
            function toNum(v) {
                v = (v || '').toString().replace(',', '.').trim();
                var n = parseFloat(v);
                return isNaN(n) ? 0 : n;
            }

            function fmt(n) {
                // форматирование
                return (Math.round(n * 10000) / 10000).toFixed(4);
            }

            function recalcStats() {
                var cost = toNum($('#input-cost-price').val());
                var price = toNum($('#input-price').val());

                if (price <= 0 && cost <= 0) {
                    $('#stat-profit').text('—');
                    $('#stat-markup').text('—');
                    $('#stat-margin').text('—');
                    return;
                }

                var profit = price - cost;

                var markup = (cost > 0) ? (profit / cost * 100) : 0;
                var margin = (price > 0) ? (profit / price * 100) : 0;

                $('#stat-profit').text(fmt(profit));
                $('#stat-markup').text((Math.round(markup * 100) / 100).toFixed(2) + '%');
                $('#stat-margin').text((Math.round(margin * 100) / 100).toFixed(2) + '%');
            }

            function setPriceFromMarkup() {
                var cost = toNum($('#input-cost-price').val());
                var pct = toNum($('#input-markup-percent').val());
                var price = cost * (1 + pct / 100);
                $('#input-price').val(fmt(price));
                recalcStats();
            }

            function setPriceFromMargin() {
                var cost = toNum($('#input-cost-price').val());
                var pct = toNum($('#input-margin-percent').val());

                if (pct >= 100) {
                    alert('Margin% cannot be >= 100');
                    return;
                }

                var price = cost / (1 - pct / 100);
                $('#input-price').val(fmt(price));
                recalcStats();
            }

            // обновляем показатели при изменении цены/закупки
            $(document).on('keyup change', '#input-cost-price, #input-price', recalcStats);

            // кнопки
            $('#btn-calc-price-markup').on('click', setPriceFromMarkup);
            $('#btn-calc-price-margin').on('click', setPriceFromMargin);

            // стартовый пересчёт
            $(recalcStats);
        })();
    </script>

</div>
{{ footer }}