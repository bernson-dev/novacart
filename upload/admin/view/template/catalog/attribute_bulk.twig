{{ header }}
{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <a href="{{ cancel }}" class="btn btn-default" data-toggle="tooltip" title="{{ button_cancel }}">
                    <i class="fa fa-reply"></i>
                </a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
            <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}

        {% if success %}
        <div class="alert alert-success alert-dismissible">
            <i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-list"></i> {{ text_form }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">

                    <div class="form-group{% if error_group %} has-error{% endif %}">
                        <label class="col-sm-2 control-label">{{ entry_group }}</label>
                        <div class="col-sm-10">
                            <select name="attribute_group_id" id="input-group" class="form-control">
                                <option value="">{{ text_select }}</option>
                                {% for group in attribute_groups %}
                                <option value="{{ group.attribute_group_id }}"
                                    {% if group.attribute_group_id == attribute_group_id %}selected{% endif %}>
                                    {{ group.name }}
                                </option>
                                {% endfor %}
                            </select>
                            {% if error_group %}
                            <div class="text-danger">{{ error_group }}</div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <!-- Способ разбивки -->
                    <div class="form-group">
                        <label class="col-sm-2 control-label">{{ entry_split_mode }}</label>
                        <div class="col-sm-10">
                            <label class="radio-inline">
                                <input type="radio" name="split_mode" value="newline"
                                {% if split_mode == 'newline' or not split_mode %}checked{% endif %}>
                                {{ text_split_newline }}
                            </label>
                            <label class="radio-inline">
                                <input type="radio" name="split_mode" value="delimiter"
                                {% if split_mode == 'delimiter' %}checked{% endif %}>
                                {{ text_split_delimiter }}
                            </label>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <div class="col-sm-offset-2 col-sm-10">
                            <div class="alert alert-info" role="alert" style="margin-top: 10px;">
                                <i class="fa fa-info-circle"></i>
                                <strong>{{ help_attribute_bulk_title }}</strong>
                                <p>{{ help_attribute_bulk }}</p>
                            </div>
                        </div>
                    </div>

                    {% for lang in languages %}
                    <div class="form-group{% if lang.language_id == default_language_id %} required{% endif %}{% if error_attribute[lang.language_id] %} has-error{% endif %}">
                        <label class="col-sm-2 control-label">
                            {{ lang.name }}
                            {% if lang.language_id == default_language_id %}
                            <br>
                            <small class="text-muted">{{ text_default_language }}</small>
                            {% endif %}
                        </label>
                        <div class="col-sm-10">
                            <textarea name="attributes[{{ lang.language_id }}]" rows="4" class="form-control">{{ attributes[lang.language_id] }}</textarea>
                            {% if error_attribute[lang.language_id] %}
                            <div class="text-danger">{{ error_attribute[lang.language_id] }}</div>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}

                    <div class="form-group">
                        <div class="col-sm-offset-2 col-sm-10">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-upload"></i> {{ button_upload }}</button>
                        </div>
                    </div>               
                </form>
            </div>
        </div>
        
        {% if report %}
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-info-circle"></i> {{ text_report }}
                </h3>
            </div>
            <div class="panel-body">
                <div style="max-height: 300px; overflow-y: auto;">
                    <ul class="list-group">
                        {% for item in report %}
                        <li class="list-group-item">
                            {% if item.status == 'added' %}
                            <i class="fa fa-check-circle text-success"></i>
                            <span class="text-success">{{ item.text }}</span>
                            {% else %}
                            <i class="fa fa-times-circle text-muted"></i>
                            <span class="text-muted">{{ item.text }}</span>
                            {% endif %}
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        {% endif %}
        
    </div>
</div>

{{ footer }}
