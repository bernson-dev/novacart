{% import "common/status_label.twig" as status %}
{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <a href="{{ refresh }}" data-toggle="tooltip" title="{{ button_currency }}" class="btn btn-warning">
                    <i class="fa fa-refresh"></i>
                </a>
                <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary">
                    <i class="fa fa-plus"></i>
                </a>
                <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger"
                    onclick="confirm('{{ text_confirm }}') ? $('#form-currency').submit() : false;">
                    <i class="fa fa-trash-o"></i>
                </button>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
            <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}

        {% if success %}
        <div class="alert alert-success alert-dismissible">
            <i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}

        {% if warning_update_needed %}
        <div class="alert alert-warning alert-dismissible">
            <i class="fa fa-exclamation-triangle"></i> {{ warning_update_needed }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}

        {# Проверяем, определен ли источник обновления валют #}
        {% if currency_engine_error %}
        <div class="alert alert-danger alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <i class="fa fa-exclamation-circle"></i> {{ currency_engine_error|raw }}
        </div>
        {% endif %}

        {% if provider_rates %}
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-line-chart"></i> {{ text_provider_rates }}: {{ provider_name }}
                </h3>
            </div>
            <div class="table-responsive">
                <table class="provider-table table table-striped table-hover">
                    <thead>
                        <tr>
                            <td class="text-left">{{ column_code }}</td>
                            <td class="text-left">{{ column_provider_title }}</td>
                            <td class="text-right">{{ column_rate }}</td>
                            <td class="text-left">{{ column_date_modified }}</td>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rate in provider_rates %}
                        <tr>
                            <td class="text-left">{{ rate.code }}</td>
                            <td class="text-left">{{ rate.title }}</td>
                            <td class="text-right">{{ rate.rate|number_format(4, '.', ' ') }}</td>
                            <td class="text-left">{{ rate.date_modified }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}

        <!-- Основная таблица валют -->
        <div class="panel panel-success">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-list"></i> {{ text_list }}
                </h3>
                <p style="line-height: 30px;">
                    <a href="{{ currency_engine_set_link}}#tab-local"
                       class="btn btn-link btn-sm"
                       data-toggle="tooltip"
                       title="{{ text_edit_currency_settings }}"
                       style="padding: 0 4px; display: inline-block;">
                        <i class="fa fa-cog"></i>
                    </a>

                    <strong>{{ text_currency_engine }}</strong>

                    <span class="label {{ currency_engine_label_class }}" style="font-size: 85%; margin: 0 5px;">
                    {{ currency_engine_title }}
                    </span>

                    <a href="{{ currency_engine_link }}"
                       class="btn btn-link btn-sm"
                       data-toggle="tooltip"
                       title="{{ text_edit_module_settings }}"
                       style="padding: 0 4px; display: inline-block;">
                        <i class="fa fa-pencil"></i>
                    </a>
                </p>
            </div>

            <div class="panel-body">
                <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-currency">
                    <div class="table-responsive">
                        <table class="currency-table table table-striped table-hover">
                            <thead>
                                <tr>
                                    <td style="width: 1px;" class="text-center">
                                        <input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" />
                                    </td>

                                    <td class="text-left">
                                        {% if sort == 'title' %}
                                        <a href="{{ sort_title }}" class="{{ order|lower }}">
                                            <i class="fa fa-font"></i> {{ column_title }}
                                        </a>
                                        {% else %}
                                        <a href="{{ sort_title }}">
                                            <i class="fa fa-font"></i> {{ column_title }}
                                        </a>
                                        {% endif %}
                                    </td>

                                    <td class="text-left">
                                        {% if sort == 'code' %}
                                        <a href="{{ sort_code }}" class="{{ order|lower }}">
                                            <i class="fa fa-code"></i> {{ column_code }}
                                        </a>
                                        {% else %}
                                        <a href="{{ sort_code }}">
                                            <i class="fa fa-code"></i> {{ column_code }}
                                        </a>
                                        {% endif %}
                                    </td>

                                    <td class="text-right">
                                        {% if sort == 'value' %}
                                        <a href="{{ sort_value }}" class="{{ order|lower }}">
                                            <i class="fa fa-balance-scale"></i> {{ column_value }}
                                        </a>
                                        {% else %}
                                        <a href="{{ sort_value }}">
                                            <i class="fa fa-balance-scale"></i> {{ column_value }}
                                        </a>
                                        {% endif %}
                                    </td>

                                    <td class="text-right">
                                        <i class="fa fa-rss"></i> {{ column_provider_rate }}
                                    </td>

                                    <td class="text-right">
                                        <i class="fa fa-percent"></i> {{ column_correction_percent }}
                                    </td>

                                    <td class="text-right">
                                        {% if sort == 'value' %}
                                        <a href="{{ sort_value }}" class="{{ order|lower }}">
                                            <i class="fa fa-exchange"></i> {{ column_reverse_value }}
                                        </a>
                                        {% else %}
                                        <a href="{{ sort_value }}">
                                            <i class="fa fa-exchange"></i> {{ column_reverse_value }}
                                        </a>
                                        {% endif %}
                                    </td>

                                    <td class="text-right">
                                        <i class="fa fa-sliders"></i> {{ column_correction_rate }}
                                    </td>

                                    <td class="text-left">
                                        {% if sort == 'status' %}
                                        <a href="{{ sort_status }}" class="{{ order|lower }}">
                                            <i class="fa fa-toggle-on"></i> {{ column_status }}
                                        </a>
                                        {% else %}
                                        <a href="{{ sort_status }}">
                                            <i class="fa fa-toggle-on"></i> {{ column_status }}
                                        </a>
                                        {% endif %}
                                    </td>

                                    <td class="text-left">
                                        {% if sort == 'date_modified' %}
                                        <a href="{{ sort_date_modified }}" class="{{ order|lower }}">
                                            <i class="fa fa-calendar"></i> {{ column_date_modified }}
                                        </a>
                                        {% else %}
                                        <a href="{{ sort_date_modified }}">
                                            <i class="fa fa-calendar"></i> {{ column_date_modified }}
                                        </a>
                                        {% endif %}
                                    </td>

                                    <td class="text-right">{{ column_action }}</td>
                                </tr>
                            </thead>

                            <tbody>
                                {% if currencies %}
                                {% for currency in currencies %}
                                <tr>
                                    <td class="text-center">
                                        <input type="checkbox" name="selected[]" value="{{ currency.currency_id }}"
                                        {% if currency.currency_id in selected %}checked="checked"{% endif %} />
                                    </td>

                                    <td class="text-left">{{ currency.title }}</td>
                                    <td class="text-left">{{ currency.code }}</td>

                                    <td class="text-right">{{ currency.value }}</td>

                                    <td class="text-right">
                                        {% if currency.provider_value is not null %}
                                        {{ currency.provider_value|number_format(8, '.', ' ') }}
                                        {% else %}
                                        —
                                        {% endif %}
                                    </td>

                                    <td class="text-right">
                                        {% if currency.delta_percent is not null %}
                                        {% set dp = currency.delta_percent|round(2) %}
                                        {% if dp > 0 %}
                                        <span style="color:#28a745;">▲ +{{ dp|number_format(2, '.', ' ') }}%</span>
                                        {% elseif dp < 0 %}
                                        <span style="color:#dc3545;">▼ {{ dp|number_format(2, '.', ' ') }}%</span>
                                        {% else %}
                                        <span style="color:#999;">● 0.00%</span>
                                        {% endif %}
                                        {% else %}
                                        —
                                        {% endif %}
                                    </td>

                                    <td class="text-right">
                                        {% if currency.value != 0 %}
                                        {{ (1 / currency.value)|number_format(8, '.', ' ') }}
                                        {% else %}
                                        —
                                        {% endif %}
                                    </td>

                                    <td class="text-right">
                                        {% if currency.correction_rate is defined %}
                                        {{ currency.correction_rate }}
                                        {% else %}
                                        —
                                        {% endif %}
                                    </td>

                                    <td class="text-left">{{ status.render(currency.status, currency.status_text) }}</td>

                                    <td class="text-left">{{ currency.date_modified }}</td>

                                    <td class="text-right">
                                        <a href="{{ currency.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                                {% else %}
                                <tr>
                                    <td class="text-center" colspan="11">{{ text_no_results }}</td>
                                </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </form>

                <div class="row">
                    <div class="col-sm-6 text-left">{{ pagination }}</div>
                    <div class="col-sm-6 text-right">{{ results }}</div>
                </div>
            </div>
        </div>
    </div>
</div>
{{ footer }}