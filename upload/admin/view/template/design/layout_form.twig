                                                        <button type="button" onclick="$('#module-row{{ module_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn-sm">
                                                            <i class="fa fa fa-minus-circle"></i></button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        {% set module_row = module_row + 1 %}
