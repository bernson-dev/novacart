    <script type="text/javascript">
        // Инициализируем глобальные счетчики строк
        var route_row = {{ route_row }};
        var module_row = {{ module_row }};

        // функция добавляет новую строку маршрута в таблицу
        function addRoute() {
            let html = `
        <tr id="route-row${route_row}">
          <td class="text-left">
            <select name="layout_route[${route_row}][store_id]" class="form-control">
              <option value="0">{{ text_default }}</option>
              {% for store in stores %}
              <option value="{{ store.store_id }}">{{ store.name|escape('js') }}</option>
              {% endfor %}
            </select>
          </td>
          <td class="text-left">
            <input type="text" name="layout_route[${route_row}][route]" value="" placeholder="{{ entry_route }}" class="form-control" />
          </td>
          <td class="text-left">
            <button type="button" onclick="$('#route-row${route_row}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger">
              <i class="fa fa-minus-circle"></i>
            </button>
          </td>
        </tr>`;
            $('#route tbody').append(html);
            route_row++;
        }

        function addModule(type) {
            let newSortOrder = $('#module-' + type + ' tbody tr').length;
            let html = `
        <tr id="module-row${module_row}">
          <td class="text-left">
            <div class="input-group">
              <span data-toggle="tooltip" title="{{ text_move }}" class="input-group-addon handle">
                <i class="fa fa-hand-grab-o"></i>
              </span>
              <select name="layout_module[${module_row}][code]" class="form-control input-sm">
                {% for extension in extensions %}
                <optgroup label="{{ extension.name|escape('js') }}">
                  {% if not extension.module %}
                  <option value="{{ extension.code }}">{{ extension.name|escape('js') }}</option>
                  {% else %}
                  {% for module in extension.module %}
                  <option value="{{ module.code }}">{{ module.name|escape('js') }}</option>
                  {% endfor %}
                  {% endif %}
                </optgroup>
                {% endfor %}
              </select>
              <input type="hidden" name="layout_module[${module_row}][position]" value="${type.replace('-', '_')}" />
              <input type="hidden" name="layout_module[${module_row}][sort_order]" value="${newSortOrder}" />
              <div class="input-group-btn">
              <a href="" target="_blank" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn-sm disabled">
                  <i class="fa fa-pencil"></i>
                </a>
                <button type="button" onclick="$('#module-row${module_row}').remove(); renumberModules('${type}');" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn-sm">
                  <i class="fa fa-minus-circle"></i>
                </button>
              </div>
            </div>
          </td>
        </tr>`;
            $('#module-' + type + ' tbody').append(html);

            let selectedValue = $('#module-' + type + ' tfoot select').val();
            $(`#module-${type} tbody select[name='layout_module[${module_row}][code]']`).val(selectedValue).trigger('change');

            renumberModules(type);
            module_row++;
        }

        function renumberModules(type) {
            $(`#module-${type} tbody input[name*='sort_order']`).each(function(i, el) {
                $(el).val(i);
            });
        }

        $('#module-column-left, #module-column-right, #module-content-top, #module-content-bottom').on('change', 'select[name*="code"]', function() {
            const part = this.value.split('.');
            const $link = $(this).closest('.input-group').find('a.btn-primary');

            if (!this.value) {
                $link.attr('href', '#').addClass('disabled');
            } else {
                const base = 'index.php?route=extension/module/';
                const token = '&user_token={{ user_token }}';
                const href = part[1]
                ? `${base}${part[0]}${token}&module_id=${part[1]}`
                : `${base}${part[0]}${token}`;

                $link.attr('href', href).removeClass('disabled');
            }
        });

        $(document).ready(function() {
            // Добавляем маркер перетаскивания, если его ещё нет
            $('.row table tbody tr .input-group').each(function() {
                if (!$(this).find('.handle').length) {
                    $(this).prepend(`
                <span data-toggle="tooltip" title="{{ text_move }}" class="input-group-addon handle">
                  <i class="fa fa-hand-grab-o"></i>
                </span>`);
                }
            });


            // Пересчёт сортировки при загрузке
            ['column-left', 'content-top', 'content-bottom', 'column-right'].forEach(renumberModules);

            // Инициализация Sortable.js
            ['column-left', 'content-top', 'content-bottom', 'column-right'].forEach(function(position) {
                const container = document.getElementById('module-' + position);
                if (container) {
                    const tableBody = container.querySelector('tbody');
                    if (tableBody) {
                        new Sortable(tableBody, {
                            handle: '.handle',
                            animation: 150,
                            onEnd: function(evt) {
                                evt.to.querySelectorAll('tr').forEach((row, index) => {
                                    const input = row.querySelector('input[name*="sort_order"]');
                                    if (input)
                                        input.value = index;
                                });
                            }
                        });
                    }
                }
            });

            // Применяем обработчик к уже существующим select'ам
            $('select[name*="code"]').trigger('change');
            // Пересчитываем все модули при загрузке страницы для обеспечения согласованности
            ['column-left', 'content-top', 'content-bottom', 'column-right'].forEach(function(position) {
                renumberModules(position);
            });
        });
    </script>
</div>
{{ footer }}