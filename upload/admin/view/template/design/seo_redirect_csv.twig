{{ header }}{{ column_left }}
<div id="content">
<div class="page-header"><div class="container-fluid"><div class="pull-right"><a href="{{ back }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
<div class="container-fluid">
{% if error_warning %}<div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert">&times;</button>{{ error_warning }}</div>{% endif %}
{% if not available %}<div class="alert alert-warning">{{ text_redirect_migration }}</div>{% else %}
<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title">{{ text_csv_title }}</h3></div><div class="panel-body">
<p>{{ text_csv_help }}</p>
<p><code>source_path;target_path;store_id;language_id;http_code;status</code></p>
<a href="{{ export }}" class="btn btn-default"><i class="fa fa-download"></i> {{ text_csv_export }}</a>
{% if can_modify %}<hr><form method="post" action="{{ action }}" enctype="multipart/form-data" id="csv-upload"><input type="hidden" name="operation" value="preview"><div class="form-group"><input type="file" name="csv" accept=".csv,text/csv" required></div><button type="button" class="btn btn-primary" id="csv-preview">{{ text_csv_preview }}</button></form>{% endif %}
</div></div>
{% if rows %}
<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title">{{ text_csv_preview }}</h3></div><div class="panel-body">
{% if report %}<div class="alert {% if report.errors or report.skipped %}alert-warning{% else %}alert-success{% endif %} alert-dismissible"><button type="button" class="close" data-dismiss="alert">&times;</button>{{ text_csv_created }}: {{ report.created }} | {{ text_diag_skipped }}: {{ report.skipped }} | {{ text_diag_errors }}: {{ report.errors }}</div>{% endif %}
<div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr><td>#</td><td>{{ entry_redirect_source }}</td><td>{{ entry_redirect_target }}</td><td>{{ column_store }}</td><td>{{ column_language }}</td><td>HTTP</td><td>{{ entry_redirect_status }}</td><td>{{ text_csv_result }}</td></tr></thead><tbody>
{% for row in rows %}<tr><td>{{ row.number }}</td><td>{{ row.data.source_path|e }}</td><td>{{ row.data.target_path|e }}</td><td>{{ row.data.store_id|e }}</td><td>{{ row.data.language_id|e }}</td><td>{{ row.data.http_code|e }}</td><td>{{ row.data.status|e }}</td><td><span class="text-{{ row.error ? 'danger' : 'success' }}">{{ row.message|e }}</span></td></tr>{% endfor %}
</tbody></table></div>
{% if nonce and can_modify %}<form method="post" action="{{ action }}" id="csv-apply"><input type="hidden" name="operation" value="apply"><input type="hidden" name="nonce" value="{{ nonce|e('html_attr') }}"><button type="button" id="csv-confirm" class="btn btn-primary" data-confirm="{{ text_csv_confirm|e('html_attr') }}">{{ text_csv_apply }}</button> <button type="button" id="csv-cancel" class="btn btn-default">{{ button_cancel }}</button></form>{% endif %}
</div></div>{% endif %}{% endif %}
</div></div>
<script>
$('#csv-preview').on('click',function(){this.form.requestSubmit();});
$('#csv-confirm').on('click',function(){if(confirm($(this).attr('data-confirm'))) HTMLFormElement.prototype.submit.call(this.form);});
$('#csv-cancel').on('click',function(){this.form.elements.operation.value='cancel'; HTMLFormElement.prototype.submit.call(this.form);});
</script>
{{ footer }}
