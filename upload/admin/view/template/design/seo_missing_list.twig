{{ header }}
{{ column_left }}
<div id="content">
    <div class="page-header"><div class="container-fluid">
        <div class="pull-right"><a href="{{ back }}" class="btn btn-default" title="{{ button_cancel }}"><i class="fa fa-reply"></i></a></div>
        <h1>{{ heading_title }}</h1>
        <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div></div>
    <div class="container-fluid">
        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-search"></i> {{ text_missing_keywords }}</h3></div>
            <div class="panel-body">
                <p>{{ text_missing_help }}</p>
                {% if shared %}<div class="alert alert-info">{{ text_missing_shared }}</div>{% endif %}
                <form method="get" action="index.php" id="seo-missing-filter" class="well">
                    <input type="hidden" name="route" value="design/seo_url/missingKeywords">
                    <input type="hidden" name="user_token" value="{{ user_token }}">
                    <div class="row">
                        <div class="col-sm-4 form-group"><label for="missing-store">{{ column_store }}</label><select name="store_id" id="missing-store" class="form-control">{% for store in stores %}<option value="{{ store.store_id }}"{% if store.store_id == store_id %} selected{% endif %}>{{ store.name|e }}</option>{% endfor %}</select></div>
                        <div class="col-sm-3 form-group"><label for="missing-type">{{ text_missing_type }}</label><select name="type" id="missing-type" class="form-control">{% for item in types %}<option value="{{ item }}"{% if item == type %} selected{% endif %}>{{ type_labels[item] }}</option>{% endfor %}</select></div>
                        <div class="col-sm-3 form-group"><label for="missing-language">{{ column_language }}</label><select name="language_id" id="missing-language" class="form-control">{% for language in languages %}<option value="{{ language.language_id }}"{% if language.language_id == language_id %} selected{% endif %}>{{ language.name|e }}</option>{% endfor %}</select></div>
                        <div class="col-sm-2 form-group"><label>&nbsp;</label><div><button type="button" id="button-missing-filter" class="btn btn-primary"><i class="fa fa-filter"></i> {{ button_filter }}</button></div></div>
                    </div>
                </form>
                {% if not languages %}<div class="alert alert-warning">{{ text_missing_no_languages }}</div>{% endif %}
                <div class="table-responsive"><table class="table table-bordered table-hover">
                    <thead><tr><td>{{ text_missing_type }}</td>{% for language in languages %}<td class="text-right">{{ language.name|e }}</td>{% endfor %}</tr></thead>
                    <tbody>{% for item in types %}<tr><td>{{ type_labels[item] }}</td>{% for language in languages %}<td class="text-right">{{ summary[item][language.language_id] }}</td>{% endfor %}</tr>{% endfor %}</tbody>
                </table></div>
                <p><strong>{{ text_missing_total }}: {{ total_missing }}</strong></p>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-eye"></i> {{ text_missing_preview }}</h3></div>
            <div class="panel-body">
                <div class="table-responsive"><table class="table table-bordered table-hover">
                    <thead><tr><td>ID</td><td>{{ column_query }}</td><td>{{ text_missing_name }}</td><td>{{ column_keyword }}</td></tr></thead>
                    <tbody>{% for row in rows %}<tr><td>{{ row.entity_id }}</td><td>{{ row.query|e }}</td><td>{{ row.name|e }}</td><td>{% if row.keyword %}{{ row.keyword|e }}{% else %}<span class="text-danger">{{ text_missing_no_keyword }}</span>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="text-center">{{ text_no_results }}</td></tr>{% endfor %}</tbody>
                </table></div>
                <div class="row"><div class="col-sm-6">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div>
            </div>
        </div>
    </div>
</div>
<script>
$('#button-missing-filter').on('click', function () {
    document.getElementById('seo-missing-filter').requestSubmit();
});
</script>
{{ footer }}
