<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>
                    <a href="{{ sort_filename }}" class="js-history-sort">
                        {{ column_filename }}
                        {% if sort == 'filename' %}
                        {% if order == 'ASC' %}
                        <i class="fa fa-sort-asc" style="margin-left:5px;"></i>
                        {% else %}
                        <i class="fa fa-sort-desc" style="margin-left:5px;"></i>
                        {% endif %}
                        {% else %}
                        <i class="fa fa-sort text-muted" style="margin-left:5px;"></i>
                        {% endif %}
                    </a>
                </th>
                <th>
                    <a href="{{ sort_date_added }}" class="js-history-sort">
                        {{ column_date_added }}
                        {% if sort == 'date_added' %}
                        {% if order == 'ASC' %}
                        <i class="fa fa-sort-asc" style="margin-left:5px;"></i>
                        {% else %}
                        <i class="fa fa-sort-desc" style="margin-left:5px;"></i>
                        {% endif %}
                        {% else %}
                        <i class="fa fa-sort text-muted" style="margin-left:5px;"></i>
                        {% endif %}
                    </a>
                </th>
                <th class="text-right">{{ column_action }}</th>
            </tr>
        </thead>
        <tbody>

            {% if histories %}
            {% for history in histories %}
            <tr>
                <td>{{ history.filename }}</td>
                <td>{{ history.date_added }}</td>
                <td class="text-right">
                    <button type="button" value="{{ history.extension_install_id }}" data-loading="{{ text_loading }}" data-toggle="tooltip" title="{{ button_uninstall }}" class="btn btn-danger">
                        <i class="fa fa-trash-o"></i></button></td>
            </tr>
            {% endfor %}
            {% else %}
            <tr>
                <td colspan="3" class="text-center">{{ text_no_results }}</td>
            </tr>
            {% endif %}
        </tbody>
    </table>
</div>
<div class="row">
    <div class="col-sm-6 text-left">{{ pagination }}</div>
    <div class="col-sm-6 text-right">{{ results }}</div>
</div>
