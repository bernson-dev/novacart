{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <a href="{{ refresh }}" data-toggle="tooltip" title="{{ button_refresh }}" class="btn btn-info">
                    <i class="fa fa-refresh"></i></a>
                <a href="{{ clear }}" data-toggle="tooltip" title="{{ button_clear }}" class="btn btn-warning">
                    <i class="fa fa-eraser"></i></a>
                <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-modification').submit() : false;">
                    <i class="fa fa-trash-o"></i></button>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
            <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        {% if success %}
        <div class="alert alert-success alert-dismissible">
            <i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        <div class="alert alert-info">
            <i class="fa fa-info-circle"></i> {{ text_refresh }}</div>
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-list"></i> {{ text_list }}</h3>
            </div>
            <div class="panel-body">
                {% if modifications %}
                <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_progress }}</label>
                    <div class="col-sm-10">
                        <div class="progress">
                            <div id="progress-bar" class="progress-bar" style="width: 0%;"></div>
                        </div>
                        <div id="progress-text"></div>
                    </div>
                </div>
                {% endif %}
                <ul class="nav nav-tabs">
                    <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
                    <li><a href="#tab-log" data-toggle="tab">{{ tab_log }}</a></li>
                    <li><a href="#tab-log-success" data-toggle="tab">{{ tab_log_success }}</a></li>
                    <li>
                        <a href="#tab-log-error" data-toggle="tab">
                            {{ tab_log_error }}
                            {% if total_error_count > 0 %}
                            <span class="badge badge-danger" title="{{ text_has_errors }}">
                            {{ total_error_count }}
                            </span>
                            {% endif %}
                        </a>
                    </li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane active" id="tab-general">
                        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-modification">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <!-- Чекбокс для массовых действий -->
                                            <td style="width: 1px;" class="text-center">
                                                <input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" />
                                            </td>

                                            <!-- Название модификатора -->
                                            <td class="text-left">
                                                {% if sort == 'name' %}
                                                <a href="{{ sort_name }}" class="{{ order|lower }}">{{ column_name }}</a>
                                                {% else %}
                                                <a href="{{ sort_name }}">{{ column_name }}</a>
                                                {% endif %}
                                            </td>

                                            <!-- Автор модификатора -->
                                            <td class="text-left">
                                                {% if sort == 'author' %}
                                                <a href="{{ sort_author }}" class="{{ order|lower }}">{{ column_author }}</a>
                                                {% else %}
                                                <a href="{{ sort_author }}">{{ column_author }}</a>
                                                {% endif %}
                                            </td>

                                            <!-- Версия модификатора -->
                                            <td class="text-left">
                                                {% if sort == 'version' %}
                                                <a href="{{ sort_version }}" class="{{ order|lower }}">{{ column_version }}</a>
                                                {% else %}
                                                <a href="{{ sort_version }}">{{ column_version }}</a>
                                                {% endif %}
                                            </td>

                                            <!-- Статус модификатора -->
                                            <td class="text-left">
                                                {% if sort == 'status' %}
                                                <a href="{{ sort_status }}" class="{{ order|lower }}">{{ column_status }}</a>
                                                {% else %}
                                                <a href="{{ sort_status }}">{{ column_status }}</a>
                                                {% endif %}
                                            </td>

                                            <!-- Дата добавления модификатора -->
                                            <td class="text-left">
                                                {% if sort == 'date_added' %}
                                                <a href="{{ sort_date_added }}" class="{{ order|lower }}">{{ column_date_added }}</a>
                                                {% else %}
                                                <a href="{{ sort_date_added }}">{{ column_date_added }}</a>
                                                {% endif %}
                                            </td>

                                            <!-- Место хранения (источник) -->
                                            <td class="text-left">
                                                {% if sort == 'source' %}
                                                <a href="{{ sort_source }}" class="{{ order|lower }}">{{ column_source }}</a>
                                                {% else %}
                                                <a href="{{ sort_source }}">{{ column_source }}</a>
                                                {% endif %}
                                            </td>

                                            <!-- Ошибки -->
                                            <td class="text-center">
                                                {% if sort == 'error_count' %}
                                                <a href="{{ sort_error_count }}" class="{{ order|lower }}">{{ column_error_count }}</a>
                                                {% else %}
                                                <a href="{{ sort_error_count }}">{{ column_error_count }}</a>
                                                {% endif %}
                                            </td>

                                            <!-- Действия -->
                                            <td class="text-right">{{ column_action }}</td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% if modifications %}
                                        {% for modification in modifications %}
                                        <tr>
                                            <td class="text-center">
                                                {% if modification.modification_id %}
                                                {% set value = modification.modification_id %}
                                                {% else %}
                                                {% set value = 'file:' ~ modification.filename %}
                                                {% endif %}

                                                {% if value in selected %}
                                                <input type="checkbox" name="selected[]" value="{{ value }}" checked="checked" />
                                                {% else %}
                                                <input type="checkbox" name="selected[]" value="{{ value }}" />
                                                {% endif %}
                                            </td>
                                            <td class="text-left">
                                                <b>{{ modification.name }}</b><br>
                                                <small>
                                                    <i>{% if modification.file_url %} {{ modification.file_url }} {% else %} {{ modification.filename }} {% endif %}</i></small>
                                            </td>
                                            <td class="text-left">{{ modification.author }}</td>
                                            <td class="text-left">{{ modification.version }}</td>
                                            <td class="text-left">
                                                {% if modification.status %}
                                                <span class="label label-success">{{ modification.status_text }}</span>
                                                {% else %}
                                                <span class="label label-danger">{{ modification.status_text }}</span>
                                                {% endif %}
                                            </td>

                                            <!-- Отображаем источник -->
                                            <td class="text-left">{{ modification.date_added }}</td>
                                            <td class="text-left">
                                                {{ modification.source }}
                                            </td>

                                            <td class="text-center">
                                                {% if modification.error_count > 0 %}
                                                <span class="label label-danger">
                                                    <i class="fa fa-exclamation-circle"></i> {{ modification.error_count }}
                                                </span>
                                                {% else %}
                                                <span class="text-muted">{{ text_no_errors }}</span>
                                                {% endif %}
                                            </td>

                                            <td class="text-right actions">
                                                <!-- Кнопка редактирования -->
                                                {% if not modification.is_file %}
                                                <a href="{{ modification.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-success">
                                                    <i class="fa fa-pencil"></i></a>
                                                {% else %}
                                                <button type="button" class="btn btn-success" disabled="disabled" data-toggle="tooltip" title="{{ tooltip_edit_disabled }}">
                                                    <i class="fa fa-pencil"></i></button>
                                                {% endif %}

                                                <!-- Кнопка скачивания -->
                                                {% if not modification.is_file %}
                                                <a href="{{ modification.download }}" data-toggle="tooltip" title="{{ button_download }}" class="btn btn-primary" download="{{ modification.filename }}">
                                                    <i class="fa fa-download"></i></a>
                                                {% else %}
                                                <button type="button" class="btn btn-primary" disabled="disabled" data-toggle="tooltip" title="{{ tooltip_download_disabled }}">
                                                    <i class="fa fa-download"></i></button>
                                                {% endif %}

                                                <!-- Кнопка загрузки -->
                                                {% if not modification.is_file %}
                                                <button type="button" data-loading-text="{{ text_loading }}" data-modification-id="{{ modification.modification_id }}" data-toggle="tooltip" title="{{ button_upload }}" class="btn btn-primary button-upload">
                                                    <i class="fa fa-upload"></i></button>
                                                {% else %}
                                                <button type="button" class="btn btn-primary" disabled="disabled" data-toggle="tooltip" title="{{ tooltip_upload_disabled }}">
                                                    <i class="fa fa-upload"></i></button>
                                                {% endif %}

                                                <!-- Кнопка ссылки -->
                                                {% if modification.link %}
                                                <a href="{{ modification.link }}" data-toggle="tooltip" title="{{ button_link }}" class="btn btn-info" target="_blank">
                                                    <i class="fa fa-link"></i></a>
                                                {% else %}
                                                <button type="button" class="btn btn-info" disabled="disabled" data-toggle="tooltip" title="{{ tooltip_link_disabled }}">
                                                    <i class="fa fa-link"></i></button>
                                                {% endif %}

                                                <!-- Кнопка включения/выключения -->
                                                {% if not modification.enabled %}
                                                <a href="{{ modification.enable }}" data-toggle="tooltip" title="{{ button_enable }}" class="btn btn-success">
                                                    <i class="fa fa-plus-circle"></i></a>
                                                {% else %}
                                                <a href="{{ modification.disable }}" data-toggle="tooltip" title="{{ button_disable }}" class="btn btn-danger">
                                                    <i class="fa fa-minus-circle"></i></a>
                                                {% endif %}
                                            </td>
                                        </tr>
                                        {% endfor %}
                                        {% else %}
                                        <tr>
                                            <td class="text-center" colspan="9">{{ text_no_results }}</td>
                                        </tr>
                                        {% endif %}
                                    </tbody>
                                </table>
                            </div>
                        </form>
                        <div class="row">
                            <div class="col-sm-6 text-left">{{ pagination }}</div>
                            <div class="col-sm-6 text-right">{{ results }}</div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab-log">
                        <p>
                            <textarea wrap="off" rows="15" class="form-control">{{ log }}</textarea>
                        </p>
                        <div class="text-center">
                            <a href="{{ clear_log_all }}" class="btn btn-danger">
                                <i class="fa fa-eraser"></i> {{ button_clear }}</a></div>
                    </div>
                    <div class="tab-pane" id="tab-log-success">
                        <p>
                            <textarea wrap="off" rows="15" class="form-control">{{ log_success }}</textarea>
                        </p>
                        <div class="text-center">
                            <a href="{{ clear_log_success }}" class="btn btn-danger">
                                <i class="fa fa-eraser"></i> {{ button_clear }}</a></div>
                    </div>
                    <div class="tab-pane" id="tab-log-error">
                        <input type="text" id="log-search" placeholder="{{ entry_log_search }}" class="form-control" style="margin-bottom:10px;">
                        <div class="form-control ocmod-log-view js-ocmod-log">{{ log_error }}</div>
                        <div class="text-center">
                            <a href="{{ clear_log_error }}" class="btn btn-danger">
                                <i class="fa fa-eraser"></i> {{ button_clear }}
                            </a>

                            <button type="button" id="copy-log"
                                    class="btn btn-default copy-btn"
                                    data-text-default='<i class="fa fa-clipboard"></i> {{ button_copy_log }}'
                                    data-text-copied='<i class="fa fa-check"></i> {{ text_log_copied }}'>
                                <i class="fa fa-clipboard"></i> {{ button_copy_log }}
                            </button>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .ocmod-log-view {
            height: 420px;
            overflow: auto;
            margin: 0 0 10px 0;
            padding: 8px;
            font-family: Consolas, Monaco, Menlo, "Courier New", monospace;
            font-size: 12px;
            line-height: 1.4;
            color: #d4d4d4;
            background: #1e1e1e;
            border: 1px solid #333;
            border-radius: 4px;
            tab-size: 4;
        }

        .ocmod-log-block {
            padding: 2px 0;
        }

        .ocmod-log-line {
            display: block;
            padding: 2px 4px;
            transition: background 0.2s;
        }
        .ocmod-log-line:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .ocmod-log-mod {
            color: #4fc3f7;
            font-weight: bold;
        }
        .ocmod-log-file {
            color: #ffcc80;
        }
        .ocmod-log-code {
            color: #c5e1a5;
        }
        .ocmod-log-regex {
            color: #ce93d8;
        }
        .ocmod-log-success {
            color: #81c784;
        }

        .ocmod-log-error {
            color: #ff8a80;
            font-weight: bold;
            border-left: 2px solid #f44336;
            padding-left: 3px;
        }

        .ocmod-log-separator {
            color: #90a4ae;
            font-weight: bold;
            display: block;
            margin: 2px 0;
            padding: 1px 0;
        }
    </style>

    <script>
        function ocmodEscapeHtml(text) {
            return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        }

        function ocmodGetLogClass(line) {
            const trimmed = line.trim();
            const lower = trimmed.toLowerCase();

            if (trimmed.startsWith('MOD: '))
                return 'ocmod-log-mod';
            if (trimmed.startsWith('FILE: '))
                return 'ocmod-log-file';
            if (trimmed.startsWith('CODE: '))
                return 'ocmod-log-code';
            if (trimmed.startsWith('REGEX: '))
                return 'ocmod-log-regex';
            if (trimmed.startsWith('LINE: '))
                return 'ocmod-log-success';

            if (trimmed.includes('NOT FOUND') ||
            trimmed.includes('ABORTING') ||
            trimmed.includes('OPERATIONS ABORTED') ||
            lower.includes('exception')) {
                return 'ocmod-log-error';
            }

            if (trimmed.includes('START') || trimmed.includes('END')) {
                return 'ocmod-log-separator';
            }

            return '';
        }

        function ocmodColorizeLog(element) {
            const text = element.textContent;
            const lines = text.split(/\r\n|\r|\n/);
            let html = '';
            let block = [];

            function flushBlock() {
                if (block.length) {
                    html += `<div class="ocmod-log-block">${block.join("")}</div>`;
                    block = [];
                }
            }

            for (let i = 0; i < lines.length; i++) {
                const line = lines[i];
                const className = ocmodGetLogClass(line);
                const lineHtml = `<span class="ocmod-log-line ${className}">${ocmodEscapeHtml(line)}</span>`;

                // если строка — сепаратор (START/END), то это отдельный блок
                if (className === 'ocmod-log-separator') {
                    flushBlock();
                    html += `<div class="ocmod-log-block">${lineHtml}</div>`;
                    continue;
                }

                // если строка начинается с FILE, то закрываем предыдущий блок и начинаем новый
                if (line.trim().startsWith('FILE: ')) {
                    flushBlock();
                }

                block.push(lineHtml);
            }
            flushBlock();

            element.innerHTML = html;
            element.scrollTop = element.scrollHeight;
        }


        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.js-ocmod-log').forEach(el => ocmodColorizeLog(el));

            // поиск по блокам
            const searchInput = document.getElementById('log-search');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const query = this.value.toLowerCase();
                    document.querySelectorAll('.ocmod-log-block').forEach(block => {
                        const text = block.textContent.toLowerCase();
                        block.style.display = query === '' || text.includes(query) ? '' : 'none';
                    });
                });
            }

            // копирование лога
            const copyBtn = document.getElementById('copy-log');

            if (copyBtn) {
                copyBtn.addEventListener('click', () => {
                    const logElement = document.querySelector('.js-ocmod-log');

                    if (!logElement) {
                        return;
                    }

                    const logText = logElement.innerText;
                    const defaultText = copyBtn.getAttribute('data-text-default') || copyBtn.innerHTML;
                    const copiedText = copyBtn.getAttribute('data-text-copied') || defaultText;

                    navigator.clipboard.writeText(logText).then(() => {
                        copyBtn.innerHTML = copiedText;

                        setTimeout(() => {
                            copyBtn.innerHTML = defaultText;
                        }, 2000);
                    });
                });
            }

        });
    </script>

    <script type="text/javascript">
        var step = [];
        var total = 0;

        $('.button-upload').on('click', function () {
            var $btn = $(this);

            // Удаляем старую форму, если была
            $('#form-upload').remove();

            var modification_id = $btn.data('modification-id');

            // Создаём скрытую форму с file input
            $('body').prepend(
            '<form enctype="multipart/form-data" id="form-upload" style="display:none;">' +
            '<input type="file" name="file" />' +
            '</form>'
            );

            var $file = $('#form-upload input[name="file"]');

            // Выбор файла (или cancel)
            $file.off('change').on('change', function () {
                // Если нажали Cancel — просто выходим
                if (!this.files || !this.files.length) {
                    return;
                }

                // Reset UI
                $('.alert').remove();
                $('#progress-bar').css('width', '0%');
                $('#progress-bar').removeClass('progress-bar-danger progress-bar-success');
                $('#progress-text').html('');

                $.ajax({
                    url: 'index.php?route=marketplace/modification/upload&user_token={{ user_token }}&modification_id=' + modification_id,
                    type: 'post',
                    dataType: 'json',
                    data: new FormData($('#form-upload')[0]),
                    cache: false,
                    contentType: false,
                    processData: false,
                    beforeSend: function () {
                        $btn.button('loading');
                    },
                    complete: function () {
                        $btn.button('reset');
                    },
                    success: function (json) {
                        if (json.error) {
                            $('#progress-bar').addClass('progress-bar-danger');
                            $('#progress-text').html('<div class="text-danger">' + json.error + '</div>');
                            return;
                        }

                        if (json.step && json.step.length) {
                            step = json.step;
                            total = step.length;
                            next();
                        }
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                    }
                });
            });

            // Открываем диалог выбора файла
            $file.trigger('click');
        });

        function next() {
            var data = step.shift();

            if (!data) {
                return;
            }

            $('#progress-bar').css('width', (100 - (step.length / total) * 100) + '%');
            $('#progress-text').html('<span class="text-info">' + data.text + '</span>');

            $.ajax({
                url: data.url,
                type: 'post',
                dataType: 'json',
                data: 'path=' + encodeURIComponent(data.path),
                success: function (json) {
                    if (json.error) {
                        $('#progress-bar').addClass('progress-bar-danger');
                        $('#progress-text').html('<div class="text-danger">' + json.error + '</div>');
                        return;
                    }

                    if (json.success) {
                        $('#progress-bar').addClass('progress-bar-success');
                        $('#progress-text').html('<span class="text-success">' + json.success + '</span>');
                        return; // если success — это финальный шаг
                    }

                    // Если не было ни success, ни error — продолжаем
                    next();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });
        }
    </script>

</div>
{{ footer }}